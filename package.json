{
  "name": "blog-sylvan-cafe",
  "type": "module",
  "version": "5.5.1",
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build && pagefind --site dist",
    "preview": "astro check && astro build && pagefind --site dist && astro preview",
    "sync": "astro sync",
    "astro": "astro",
    "prepare": "husky",
    "lint": "biome check . && stylelint \"**/*.{css,astro}\"",
    "lint:fix": "biome check --write . && stylelint \"**/*.{css,astro}\" --fix",
    "format:check": "biome format .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@astrojs/partytown": "^2.1.7",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.2",
    "@fontsource/fira-code": "^5.2.7",
    "@fontsource/noto-sans": "^5.2.10",
    "@fontsource/noto-sans-jp": "^5.2.9",
    "@fontsource/noto-sans-sc": "^5.2.9",
    "@iconify-json/circle-flags": "^1.2.10",
    "@iconify-json/tabler": "^1.2.35",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.0",
    "astro": "^6.3.3",
    "astro-icon": "^1.1.5",
    "beautiful-mermaid": "github:Sylvan-Cheng/beautiful-mermaid",
    "dayjs": "^1.11.20",
    "katex": "^0.16.47",
    "lodash.kebabcase": "^4.1.1",
    "medium-zoom": "^1.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-collapse": "^0.1.2",
    "remark-github-blockquote-alert": "^2.1.0",
    "remark-math": "^6.0.0",
    "remark-toc": "^9.0.0",
    "satori": "^0.26.0",
    "sharp": "^0.34.5",
    "slugify": "^1.6.9",
    "tailwindcss": "^4.3.0",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@biomejs/biome": "^2.4.15",
    "@pagefind/default-ui": "^1.5.2",
    "@shikijs/transformers": "^4.0.2",
    "@tailwindcss/typography": "^0.5.19",
    "@types/hast": "^3.0.4",
    "@types/lodash.kebabcase": "^4.1.9",
    "@types/mdast": "^4.0.4",
    "husky": "^9.1.7",
    "pagefind": "^1.5.2",
    "postcss-html": "^1.8.1",
    "stylelint": "^17.12.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3"
  }
}