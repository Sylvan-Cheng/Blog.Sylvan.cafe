{
  "name": "blog-sylvan-cafe",
  "type": "module",
  "version": "5.5.1",
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/collect-image-metadata.mjs && astro check && astro build && pagefind --site dist --silent",
    "preview": "node scripts/collect-image-metadata.mjs && astro check && astro build && pagefind --site dist --silent && astro preview",
    "sync": "astro sync",
    "astro": "astro",
    "images:metadata": "node scripts/collect-image-metadata.mjs",
    "generate:og": "node scripts/generate-og-image.mjs",
    "probe:satteri": "node scripts/probe-satteri-markdown.mjs",
    "prepare": "husky",
    "lint": "biome check . && stylelint \"**/*.{css,astro}\"",
    "lint:fix": "biome check --write . && stylelint \"**/*.{css,astro}\" --fix",
    "format:check": "biome format .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.3.2",
    "@astrojs/partytown": "^2.1.7",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/fira-code": "^5.2.7",
    "@fontsource/noto-sans": "^5.2.10",
    "@fontsource/noto-sans-jp": "^5.2.9",
    "@fontsource/noto-sans-sc": "^5.2.9",
    "@iconify-json/tabler": "^1.2.35",
    "@tailwindcss/vite": "^4.3.1",
    "astro": "^7.0.3",
    "astro-icon": "^1.1.5",
    "beautiful-mermaid": "github:Sylvan-Cheng/beautiful-mermaid",
    "dayjs": "^1.11.21",
    "hast-util-from-html": "^2.0.3",
    "hast-util-to-html": "^9.0.5",
    "katex": "^0.17.0",
    "photoswipe": "^5.4.4",
    "sharp": "^0.35.2",
    "slugify": "^1.6.9",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@biomejs/biome": "^2.5.0",
    "@pagefind/component-ui": "^1.5.2",
    "@resvg/resvg-js": "^2.6.2",
    "@shikijs/transformers": "^4.2.0",
    "@tailwindcss/typography": "^0.5.20",
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "husky": "^9.1.7",
    "pagefind": "^1.5.2",
    "postcss-html": "^1.8.1",
    "satori": "^0.26.0",
    "stylelint": "^17.13.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3"
  }
}
