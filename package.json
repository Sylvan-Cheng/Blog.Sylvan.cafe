{
  "name": "blog-sylvan-cafe",
  "type": "module",
  "version": "5.5.1",
  "packageManager": "pnpm@12.1.0",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/check-theme-tokens.mjs && node scripts/test-date-formatting.mjs && node scripts/test-markdown-rendering.mjs && node scripts/test-seo-models.mjs && node scripts/test-image-metadata.mjs && node scripts/clear-astro-content-cache.mjs && node scripts/collect-image-metadata.mjs && astro check && astro build && pagefind --site dist --silent && node scripts/check-production-artifact.mjs dist && node scripts/check-seo-output.mjs dist",
    "preview": "pnpm run build && astro preview",
    "sync": "astro sync",
    "astro": "astro",
    "images:metadata": "node scripts/collect-image-metadata.mjs",
    "generate:og": "node scripts/generate-og-image.mjs",
    "test:theme": "node scripts/check-theme-tokens.mjs",
    "test:date": "node scripts/test-date-formatting.mjs",
    "test:markdown": "node scripts/test-markdown-rendering.mjs",
    "prepare": "husky",
    "lint": "biome check . && stylelint \"**/*.{css,astro}\"",
    "lint:fix": "biome check --write . && stylelint \"**/*.{css,astro}\" --fix",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.3.8",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/noto-sans-jp": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.0",
    "@iconify-json/tabler": "^1.2.38",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.9",
    "astro-icon": "^1.2.0",
    "beautiful-mermaid": "github:Sylvan-Cheng/beautiful-mermaid",
    "hast-util-from-html": "^2.0.3",
    "hast-util-to-html": "^9.0.5",
    "katex": "^0.18.4",
    "photoswipe": "^5.4.4",
    "sharp": "^0.35.4",
    "slugify": "^1.6.9",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@biomejs/biome": "^2.5.11",
    "@pagefind/component-ui": "^1.5.2",
    "@shikijs/transformers": "^4.4.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/hast": "^3.0.5",
    "husky": "^9.1.7",
    "pagefind": "^1.5.2",
    "postcss-html": "^2.0.0",
    "satori": "^0.33.4",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3"
  }
}
