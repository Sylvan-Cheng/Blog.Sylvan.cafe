---
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import LinkButton from "@/components/LinkButton.astro";
import { SITE } from "@/config";
import { LOCALE_META, LOCALES } from "@/i18n/config";
import { UI } from "@/i18n/ui";
import { resolveLocale, t } from "@/i18n/utils";
import Layout from "@/layouts/Layout.astro";

const locale = resolveLocale(Astro.currentLocale);
const defaultLocale = LOCALES[0];
const notFoundText = Object.fromEntries(
  LOCALES.map((loc) => [loc, t(UI.notFound, loc)]),
);
const goHomeText = Object.fromEntries(
  LOCALES.map((loc) => [loc, t(UI.goHome, loc)]),
);
const langMap = Object.fromEntries(
  LOCALES.map((loc) => [loc, LOCALE_META[loc].lang]),
);
const notFoundI18n = JSON.stringify({
  defaultLocale,
  goHomeText,
  langMap,
  locales: LOCALES,
  notFoundText,
});
---

<Layout title={`404 Not Found | ${SITE.title}`}>
  <Header />

  <main
    id="main-content"
    class="app-layout flex flex-1 items-center justify-center"
  >
    <div class="mb-14 flex flex-col items-center justify-center">
      <h1 class="text-9xl font-bold text-accent">404</h1>
      <span aria-hidden="true">&macr;\_(ツ)_/&macr;</span>
      <p id="not-found-text" class="mt-4 text-2xl sm:text-3xl">{t(UI.notFound, locale)}</p>
      <LinkButton
        id="go-home-link"
        href={`/${locale}/`}
        class="tone-link-strong my-6 text-lg"
      >
        {t(UI.goHome, locale)}
      </LinkButton>
    </div>
  </main>

  <Footer />
</Layout>

<script is:inline id="not-found-i18n" type="application/json" set:html={notFoundI18n}></script>
<script is:inline>
  (function () {
    var rawData = document.getElementById("not-found-i18n");
    var i18n = JSON.parse(rawData ? rawData.textContent || "{}" : "{}");
    var path = window.location.pathname;
    var locale = i18n.locales.find(function (loc) {
      return path === "/" + loc || path.indexOf("/" + loc + "/") === 0;
    }) || i18n.defaultLocale;

    var notFoundEl = document.getElementById("not-found-text");
    var goHomeEl = document.getElementById("go-home-link");

    if (notFoundEl) notFoundEl.textContent = i18n.notFoundText[locale] || i18n.notFoundText[i18n.defaultLocale];
    if (goHomeEl) {
      goHomeEl.textContent = i18n.goHomeText[locale] || i18n.goHomeText[i18n.defaultLocale];
      goHomeEl.href = "/" + locale + "/";
    }
    document.documentElement.lang = i18n.langMap[locale] || i18n.langMap[i18n.defaultLocale];
  })();
</script>
