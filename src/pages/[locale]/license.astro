---
import { getEntry, render } from "astro:content";
import { LOCALES } from "@/i18n/config";
import { UI } from "@/i18n/ui";
import { resolveLocale, t } from "@/i18n/utils";
import StaticPage from "@/layouts/StaticPage.astro";

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = resolveLocale(Astro.currentLocale);
const page = await getEntry("pages", `license/${locale}`);
const { Content } = page ? await render(page) : { Content: null };
---

<StaticPage
  {Content}
  notFoundText={t(UI.notFound, locale)}
  pageDesc={t(UI.license.desc, locale)}
  pageTitle={page?.data.title ?? "License"}
/>
