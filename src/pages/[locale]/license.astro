---
import { getEntry, render } from "astro:content";
import { LOCALES } from "@/i18n/config";
import { resolveLocale, t } from "@/i18n/utils";
import { UI } from "@/i18n/ui";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/layouts/Main.astro";
import Footer from "@/components/Footer.astro";
import { SITE } from "@/config";

export function getStaticPaths() {
  return LOCALES.map(locale => ({ params: { locale } }));
}

const locale = resolveLocale(Astro.currentLocale);
const page = await getEntry("pages", `license/${locale}`);
const { Content } = page ? await render(page) : { Content: null };
---

<Layout title={`${page?.data.title ?? "License"} | ${SITE.title}`}>
  <Header />
  <Main pageTitle={page?.data.title ?? "License"} pageDesc={t(UI.license.desc, locale)}>
    {
      Content ? (
        <article class="app-prose max-w-app prose-img:border-0">
          <Content />
        </article>
      ) : (
        <section class="app-prose max-w-app prose-img:border-0">
          <p>{t(UI.notFound, locale)}</p>
        </section>
      )
    }
  </Main>
  <Footer />
</Layout>
