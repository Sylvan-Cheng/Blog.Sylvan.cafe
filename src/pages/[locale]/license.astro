---
import { getEntry, render } from "astro:content";
import { LOCALES } from "@/i18n/config";
import { resolveLocale, t } from "@/i18n/utils";
import { UI } from "@/i18n/ui";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Footer from "@/components/Footer.astro";
import { SITE } from "@/config";

export function getStaticPaths() {
  return LOCALES.map(locale => ({ params: { locale } }));
}

const locale = resolveLocale(Astro.currentLocale);
const page = await getEntry("pages", `license/${locale}`);
const { Content } = page ? await render(page) : { Content: null };
---

<Layout title={`${page?.data.title ?? "License"} | ${SITE.title}`}>
  <Header />
  <Breadcrumb />
  {
    Content ? (
      <main id="main-content" class="app-layout">
        <article class="app-prose mb-28 max-w-app prose-img:border-0">
          <Content />
        </article>
      </main>
    ) : (
      <main id="main-content" class="app-layout">
        <section class="app-prose mb-28 max-w-app prose-img:border-0">
          <h1 class="text-2xl tracking-wider sm:text-3xl">License</h1>
          <p>{t(UI.notFound, locale)}</p>
        </section>
      </main>
    )
  }
  <Footer />
</Layout>
