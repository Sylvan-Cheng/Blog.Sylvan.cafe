---
import { getCollection } from "astro:content";
import { LOCALES } from "@/i18n/config";
import { resolveLocale, t } from "@/i18n/utils";
import { UI } from "@/i18n/ui";
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Tag from "@/components/Tag.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import getUniqueTags from "@/utils/getUniqueTags";
import { SITE } from "@/config";

export function getStaticPaths() {
  return LOCALES.map(locale => ({ params: { locale } }));
}

const locale = resolveLocale(Astro.currentLocale);
const allPosts = await getCollection("blog");
const posts = allPosts.filter(p => p.data.locale === locale);
let tags = getUniqueTags(posts);
---

<Layout title={`${t(UI.tags.title, locale)} | ${SITE.title}`}>
  <Header />
  <Main pageTitle={t(UI.tags.title, locale)} pageDesc={t(UI.tags.desc, locale)}>
    <ul class="flex flex-wrap gap-6">
      {tags.map(({ tag, tagName }) => <Tag {tag} {tagName} />)}
    </ul>
  </Main>
  <Footer />
</Layout>
