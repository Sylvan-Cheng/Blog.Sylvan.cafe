---
import { getCollection } from "astro:content";
import { LOCALES } from "@/i18n/config";
import type { GetStaticPathsOptions } from "astro";
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import Pagination from "@/components/Pagination.astro";
import getUniqueTags from "@/utils/getUniqueTags";
import getPostsByTag from "@/utils/getPostsByTag";
import { SITE } from "@/config";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const allPosts = await getCollection("blog");
  const locales = LOCALES;
  const results = [];
  for (const loc of locales) {
    const localePosts = allPosts.filter(p => p.data.locale === loc);
    const tags = getUniqueTags(localePosts);
    for (const { tag, tagName } of tags) {
      const tagPosts = getPostsByTag(localePosts, tag);
      if (tagPosts.length === 0) continue;
      const pages = await paginate(tagPosts, {
        params: { locale: loc, tag },
        props: { tagName },
        pageSize: SITE.postPerPage,
      });
      results.push(...pages);
    }
  }
  return results;
}

const params = Astro.params;
const locale = Astro.currentLocale ?? "zh";
const i18nTag = locale === "zh" ? "标签" : locale === "ja" ? "タグ" : locale === "ru" ? "Тег" : "Tag";
const i18nDesc = (tag: string) =>
  locale === "zh" ? `所有带有 "${tag}" 标签的文章。`
  : locale === "ja" ? `「${tag}」タグの付いた全ての記事です。`
  : locale === "ru" ? `Все записи с тегом "${tag}".`
  : `All the articles with the tag "${tag}".`;
const { tag } = params;
const { page, tagName } = Astro.props;
---

<Layout title={`${i18nTag}: ${tagName} | ${SITE.title}`}>
  <Header />
  <Main
    pageTitle={[`${i18nTag}:`, `${tagName}`]}
    titleTransition={tag}
    pageDesc={i18nDesc(tagName)}
  >
    <h1 slot="title" transition:name={tag}>{`${i18nTag}:${tag}`}</h1>
    <ul>
      {page.data.map(data => <Card {...data} locale={locale} />)}
    </ul>
  </Main>

  <Pagination {page} />

  <Footer noMarginTop={page.lastPage > 1} />
</Layout>
