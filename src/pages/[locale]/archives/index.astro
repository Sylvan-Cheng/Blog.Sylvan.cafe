---
import type { CollectionEntry } from "astro:content";
import Card from "@/components/Card.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import { SITE } from "@/config";
import { LOCALES } from "@/i18n/config";
import { UI } from "@/i18n/ui";
import { resolveLocale, t } from "@/i18n/utils";
import Layout from "@/layouts/Layout.astro";
import Main from "@/layouts/Main.astro";
import { getPublishedPostsByLocale } from "@/utils/blogRepository";

type GroupKey = string | number | symbol;

function groupBy(
  posts: CollectionEntry<"blog">[],
  fn: (item: CollectionEntry<"blog">) => GroupKey,
): Record<GroupKey, CollectionEntry<"blog">[]> {
  const result: Record<GroupKey, CollectionEntry<"blog">[]> = {};
  for (const post of posts) {
    const key = fn(post);
    if (!result[key]) result[key] = [];
    result[key].push(post);
  }
  return result;
}

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

if (!SITE.showArchives) {
  return Astro.redirect("/404");
}

const locale = resolveLocale(Astro.currentLocale);
const months = UI.months[locale] ?? UI.months.en;

const posts = await getPublishedPostsByLocale(locale);
---

<Layout title={`${t(UI.archives.title, locale)} | ${SITE.title}`}>
  <Header />
  <Main pageTitle={t(UI.archives.title, locale)} pageDesc={t(UI.archives.desc, locale)}>
    {
      Object.entries(
        groupBy(posts, post =>
          post.data.pubDatetime.getFullYear()
        )
      )
        .sort(([yearA], [yearB]) => Number(yearB) - Number(yearA))
        .map(([year, yearGroup]) => (
          <div>
            <span class="text-2xl font-bold">{year}</span>
            <sup class="text-sm">{yearGroup.length}</sup>
            {Object.entries(
              groupBy(
                yearGroup,
                post => post.data.pubDatetime.getMonth() + 1
              )
            )
              .sort(([monthA], [monthB]) => Number(monthB) - Number(monthA))
              .map(([month, monthGroup]) => (
                <div class="flex flex-col sm:flex-row">
                  <div class="mt-6 min-w-36 text-lg sm:my-6">
                    <span class="font-bold">{months[Number(month) - 1]}</span>
                    <sup class="text-xs">{monthGroup.length}</sup>
                  </div>
                  <ul>
                    {monthGroup
                      .sort(
                        (a, b) =>
                          Math.floor(
                            new Date(b.data.pubDatetime).getTime() / 1000
                          ) -
                          Math.floor(
                            new Date(a.data.pubDatetime).getTime() / 1000
                          )
                      )
                      .map(data => (
                        <Card {...data} locale={locale} />
                      ))}
                  </ul>
                </div>
              ))}
          </div>
        ))
    }
  </Main>
  <Footer />
</Layout>
