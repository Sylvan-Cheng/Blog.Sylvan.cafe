---
import { getEntry, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE } from "@/config";

export function getStaticPaths() {
  return [
    { params: { locale: "zh" } },
    { params: { locale: "en" } },
    { params: { locale: "ja" } },
    { params: { locale: "ru" } },
  ];
}

const locale = Astro.currentLocale ?? "zh";
const page = await getEntry("pages", `about/${locale}`);
const { Content } = page ? await render(page) : { Content: null };
---

<Layout title={`${page?.data.title ?? "About"} | ${SITE.title}`}>
  <Header />
  {
    Content ? (
      <main id="main-content" class="app-layout">
        <article class="app-prose mb-28 max-w-app prose-img:border-0">
          <Content />
        </article>
      </main>
    ) : (
      <main id="main-content" class="app-layout">
        <section class="app-prose mb-28 max-w-app prose-img:border-0">
          <h1 class="text-2xl tracking-wider sm:text-3xl">About</h1>
          <p>Page not found.</p>
        </section>
      </main>
    )
  }
  <Footer />
</Layout>
