---
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import { SITE } from "@/config";
import { LOCALES } from "@/i18n/config";
import { UI } from "@/i18n/ui";
import { resolveLocale, t } from "@/i18n/utils";
import Layout from "@/layouts/Layout.astro";
import Main from "@/layouts/Main.astro";
import "@pagefind/component-ui/css/pagefind-component-ui.css";

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = resolveLocale(Astro.currentLocale);
const isDev = import.meta.env.DEV;

const backUrl = SITE.showBackButton ? `${Astro.url.pathname}` : "/";

const devSearchWarningTitle = {
  zh: "开发模式提示",
  en: "Development mode",
  ja: "開発モード",
  ru: "Режим разработки",
  eo: "Evoluiga reĝimo",
} satisfies Record<(typeof LOCALES)[number], string>;

const devSearchWarningDesc = {
  zh: "搜索索引只会在构建后生成。请运行以下命令预览搜索结果。",
  en: "The search index is generated only after build. Run the command below to preview search results.",
  ja: "検索インデックスはビルド後に生成されます。検索結果を確認するには次のコマンドを実行してください。",
  ru: "Поисковый индекс создаётся только после сборки. Выполните команду ниже, чтобы проверить поиск.",
  eo: "La serĉa indekso kreiĝas nur post konstruo. Rulu la jenan komandon por antaŭrigardi serĉrezultojn.",
} satisfies Record<(typeof LOCALES)[number], string>;
---

<Layout title={`${t(UI.search.title, locale)} | ${SITE.title}`}>
  <Header />
  <Main pageTitle={t(UI.search.title, locale)} pageDesc={t(UI.search.desc, locale)}>
    <div
      id="pagefind-search"
      class="search-ui"
      transition:persist
      data-backurl={backUrl}
      data-pagefind-search={isDev ? undefined : true}
      data-search-locale={locale}
    >
      {
        isDev ? (
          <div class="bg-muted/75 rounded p-4 space-y-4" data-pagefind-dev-warning>
            <p>
              <strong>{devSearchWarningTitle[locale]}</strong>
              <br />
              {devSearchWarningDesc[locale]}
            </p>
            <code class="block bg-foreground px-2 py-1 text-background rounded">pnpm run preview</code>
          </div>
        ) : (
          <>
            <pagefind-input
              instance="site-search"
              autofocus
              placeholder={t(UI.search.title, locale)}
            ></pagefind-input>
            <pagefind-summary instance="site-search"></pagefind-summary>
            <pagefind-results
              instance="site-search"
              show-images="false"
              max-sub-results="4"
            ></pagefind-results>
          </>
        )
      }
    </div>
  </Main>
  <Footer />
</Layout>

<script src="../../scripts/search.ts"></script>

<style is:global>
  #pagefind-search,
  #pagefind-search pagefind-input,
  #pagefind-search pagefind-summary,
  #pagefind-search pagefind-results {
    --pf-font: var(--font-body);
    --pf-text: var(--foreground);
    --pf-text-secondary: var(--text-secondary);
    --pf-text-muted: var(--text-muted);
    --pf-background: var(--background);
    --pf-border: var(--border);
    --pf-border-focus: var(--accent);
    --pf-hover: var(--muted);
    --pf-mark: var(--accent);
    --pf-skeleton: var(--muted);
    --pf-skeleton-shine: color-mix(in srgb, var(--muted) 80%, var(--foreground));
    --pf-outline-focus: var(--accent);
    --pf-input-height: 2.75rem;
    --pf-input-font-size: 1rem;
    --pf-summary-font-size: 0.875rem;
    --pf-result-title-font-size: 1rem;
    --pf-result-excerpt-font-size: 0.9375rem;
    --pf-border-radius: 0.375rem;
    --pf-results-gap: 0.75rem;

    color: var(--foreground);
  }

  #pagefind-search[data-search-ready="true"] {
    display: grid;
    gap: 1rem;
  }

  #pagefind-search .pf-input-wrapper::before {
    background-color: var(--text-muted) !important;
  }

  #pagefind-search .pf-input-wrapper:has(.pf-input:focus)::before,
  #pagefind-search .pf-input-wrapper:has(.pf-input:focus-visible)::before {
    background-color: var(--foreground) !important;
  }

  #pagefind-search .pf-input {
    background-color: var(--background);
    border: 1px solid var(--border);
    color: var(--foreground);
    font-weight: 400;
  }

  #pagefind-search .pf-input::placeholder {
    color: var(--text-muted);
  }

  #pagefind-search .pf-input:focus,
  #pagefind-search .pf-input:focus-visible {
    border-color: var(--accent) !important;
    box-shadow: none !important;
    outline: 0 !important;
  }

  #pagefind-search .pf-input-clear {
    color: var(--text-muted);
  }

  #pagefind-search .pf-input-clear:hover {
    background: var(--muted);
    color: var(--foreground);
  }

  #pagefind-search .pf-input-clear:focus-visible,
  #pagefind-search .pf-result-link:focus-visible,
  #pagefind-search .pf-heading-link:focus-visible {
    outline: 2px dashed var(--accent) !important;
    outline-offset: 2px !important;
  }

  #pagefind-search .pf-summary {
    color: var(--foreground) !important;
    font-weight: 700 !important;
  }

  #pagefind-search .pf-result-card {
    border-color: var(--border);
    background: color-mix(in srgb, var(--background) 92%, var(--muted));
    color: var(--foreground);
  }

  #pagefind-search .pf-result-card:hover {
    background: var(--muted);
  }

  #pagefind-search .pf-result-link,
  #pagefind-search .pf-heading-link {
    color: var(--foreground);
    outline-offset: 1px;
    outline-color: var(--accent);
    text-decoration-style: dashed;
    text-underline-offset: 4px;
  }

  #pagefind-search .pf-result-link:hover,
  #pagefind-search .pf-heading-link:hover {
    text-decoration-line: none !important;
  }

  #pagefind-search .pf-result-excerpt,
  #pagefind-search .pf-heading-excerpt {
    color: var(--foreground);
  }

  #pagefind-search .pf-heading-chip {
    color: var(--foreground);
  }

  #pagefind-search mark {
    color: var(--accent);
    background: transparent;
  }
</style>
