---
import { type CollectionEntry, getCollection } from "astro:content";
import { LOCALES } from "@/i18n/config";
import PostDetails from "@/layouts/PostDetails.astro";
import { getPostSlugPath } from "@/utils/contentIdentity";
import getSortedPosts from "@/utils/getSortedPosts";
import { postFilter } from "@/utils/postFilter";
import {
  buildTranslationMap,
  groupPostsByTranslationKey,
} from "@/utils/postTranslations";

type Props = {
  post: CollectionEntry<"blog">;
  translationMap: Record<string, string>;
  posts: CollectionEntry<"blog">[];
};

export async function getStaticPaths() {
  const allPosts = (await getCollection("blog")).filter(postFilter);

  const postsByKey = groupPostsByTranslationKey(allPosts);

  // Pre-compute sorted posts per locale
  const sortedByLocale = Object.fromEntries(
    LOCALES.map((loc) => [
      loc,
      getSortedPosts(allPosts.filter((p) => p.data.locale === loc)),
    ]),
  );

  return LOCALES.flatMap((locale) =>
    allPosts
      .filter((post) => post.data.locale === locale)
      .map((post) => {
        return {
          params: { locale, slug: getPostSlugPath(post) },
          props: {
            post,
            translationMap: buildTranslationMap(post, postsByKey),
            posts: sortedByLocale[locale],
          },
        };
      }),
  );
}

const { post, translationMap, posts } = Astro.props;
---
<PostDetails post={post} posts={posts} translationMap={translationMap} />
