---
import type { CollectionEntry } from "astro:content";
import { LOCALES } from "@/i18n/config";
import PostDetails from "@/layouts/PostDetails.astro";
import { getPostIndex, type PostIndex } from "@/utils/blogRepository";
import { getPostSlugPath } from "@/utils/contentIdentity";

type Props = {
  post: CollectionEntry<"blog">;
  postIndex: PostIndex;
};

export async function getStaticPaths() {
  const postIndex = await getPostIndex();

  return LOCALES.flatMap((locale) =>
    postIndex.posts
      .filter((post) => post.data.locale === locale)
      .map((post) => {
        return {
          params: { locale, slug: getPostSlugPath(post) },
          props: {
            post,
            postIndex,
          },
        };
      }),
  );
}

const { post, postIndex } = Astro.props;
---
<PostDetails post={post} postIndex={postIndex} />
