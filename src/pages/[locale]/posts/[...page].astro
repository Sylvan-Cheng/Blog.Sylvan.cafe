---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import { LOCALES } from "@/i18n/config";
import { resolveLocale, t } from "@/i18n/utils";
import { UI } from "@/i18n/ui";
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import Pagination from "@/components/Pagination.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { SITE } from "@/config";

const locale = resolveLocale(Astro.currentLocale);

export const getStaticPaths = (async ({ paginate }) => {
  const locales = LOCALES;
  const allPosts = await getCollection("blog", ({ data }) => !data.draft);
  const results = [];
  for (const loc of locales) {
    const localePosts = allPosts.filter(p => p.data.locale === loc);
    const pages = await paginate(getSortedPosts(localePosts), {
      params: { locale: loc },
      pageSize: SITE.postPerPage,
    });
    results.push(...pages);
  }
  return results;
}) satisfies GetStaticPaths;

const { page } = Astro.props;
---

<Layout title={`${t(UI.posts.title, locale)} | ${SITE.title}`}>
  <Header />
  <Main pageTitle={t(UI.posts.title, locale)} pageDesc={t(UI.posts.desc, locale)}>
    <ul>
      {page.data.map(data => <Card {...data} locale={locale} />)}
    </ul>
  </Main>

  <Pagination {page} />

  <Footer noMarginTop={page.lastPage > 1} />
</Layout>
