---
import type { GetStaticPaths } from "astro";
import Card from "@/components/Card.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import Pagination from "@/components/Pagination.astro";
import { SITE } from "@/config";
import { UI } from "@/i18n/ui";
import { resolveLocale, t } from "@/i18n/utils";
import Layout from "@/layouts/Layout.astro";
import Main from "@/layouts/Main.astro";
import { buildPostListStaticPaths } from "@/utils/postListPageModel";

const locale = resolveLocale(Astro.currentLocale);

export const getStaticPaths = (async ({ paginate }) => {
  return buildPostListStaticPaths(paginate);
}) satisfies GetStaticPaths;

const { page } = Astro.props;
---

<Layout title={`${t(UI.posts.title, locale)} | ${SITE.title}`}>
  <Header />
  <Main pageTitle={t(UI.posts.title, locale)} pageDesc={t(UI.posts.desc, locale)}>
    <ul class="line-frame border-b">
      {page.data.map(data => <Card {...data} locale={locale} />)}
    </ul>
  </Main>

  <Pagination {page} />

  <Footer noMarginTop={page.lastPage > 1} />
</Layout>
