---
import type { GetStaticPaths } from "astro";
import Card from "@/components/Card.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import Pagination from "@/components/Pagination.astro";
import { SITE } from "@/config";
import { LOCALES } from "@/i18n/config";
import { UI } from "@/i18n/ui";
import { resolveLocale, t } from "@/i18n/utils";
import Layout from "@/layouts/Layout.astro";
import Main from "@/layouts/Main.astro";
import { getPostsByLocale, sortPosts } from "@/utils/blogRepository";

const locale = resolveLocale(Astro.currentLocale);

export const getStaticPaths = (async ({ paginate }) => {
  const locales = LOCALES;
  const results = [];
  for (const loc of locales) {
    const localePosts = await getPostsByLocale(loc);
    const pages = paginate(sortPosts(localePosts), {
      params: { locale: loc },
      pageSize: SITE.postPerPage,
    });
    results.push(...pages);
  }
  return results;
}) satisfies GetStaticPaths;

const { page } = Astro.props;
---

<Layout title={`${t(UI.posts.title, locale)} | ${SITE.title}`}>
  <Header />
  <Main pageTitle={t(UI.posts.title, locale)} pageDesc={t(UI.posts.desc, locale)}>
    <ul>
      {page.data.map(data => <Card {...data} locale={locale} />)}
    </ul>
  </Main>

  <Pagination {page} />

  <Footer noMarginTop={page.lastPage > 1} />
</Layout>
