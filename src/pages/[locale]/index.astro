---
import Card from "@/components/Card.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import Icon from "@/components/Icon.astro";
import LinkButton from "@/components/LinkButton.astro";
import Socials from "@/components/Socials.astro";
import { SITE } from "@/config";
import { SOCIALS } from "@/constants";
import { LOCALES } from "@/i18n/config";
import { UI } from "@/i18n/ui";
import { resolveLocale, t } from "@/i18n/utils";
import Layout from "@/layouts/Layout.astro";
import { getSortedPublishedPosts } from "@/utils/blogRepository";

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = resolveLocale(Astro.currentLocale);

const sortedPosts = await getSortedPublishedPosts(locale);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
---

<Layout title={t(UI.home.greeting, locale)} description={t(UI.home.desc, locale)}>
  <Header />
  <main id="main-content" data-layout="index" data-backurl={`/${locale}/`} class="app-layout overflow-x-clip">
    <section id="hero" class:list={["pt-8 pb-6", "border-b border-border"]}>
      <h1 class="my-4 inline-block text-4xl font-bold sm:my-8 sm:text-5xl">
        {t(UI.home.greeting, locale)}
      </h1>
      <LinkButton
        href={`/${locale}/rss.xml`}
        class="flex p-3 sm:p-1"
        title="RSS Feed"
        aria-label="rss feed"
        target="_blank"
      >
        <Icon name="tabler:rss" />
        <span class="sr-only">RSS Feed</span>
      </LinkButton>

      <p>{t(UI.home.desc, locale)}</p>
      <p class="mt-2">
        {t(UI.rss.subscribe, locale)}
      </p>
      {
        // only display if at least one social link is enabled
        SOCIALS.length > 0 && (
          <div class="mt-4 flex max-sm:flex-col sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">{t(UI.home.socialLinks, locale)}</div>
            <Socials />
          </div>
        )
      }
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-12 pb-6",
            { "border-b border-border": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">{t(UI.home.featured, locale)}</h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} locale={locale} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">{t(UI.home.recent, locale)}</h2>
          <ul>
            {recentPosts.slice(0, SITE.postPerIndex).map(data => (
              <Card variant="h3" {...data} locale={locale} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href={`/${locale}/posts/`}>
        {t(UI.home.allPosts, locale)}
        <Icon name="tabler:arrow-right" class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>
