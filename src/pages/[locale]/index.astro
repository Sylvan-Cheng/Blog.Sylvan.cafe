---
import Card from "@/components/Card.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import Icon from "@/components/Icon.astro";
import LinkButton from "@/components/LinkButton.astro";
import Socials from "@/components/Socials.astro";
import { SITE } from "@/config";
import { SOCIALS } from "@/constants";
import { LOCALES } from "@/i18n/config";
import { UI } from "@/i18n/ui";
import { resolveLocale, t } from "@/i18n/utils";
import Layout from "@/layouts/Layout.astro";
import { getSortedPosts } from "@/utils/blogRepository";

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = resolveLocale(Astro.currentLocale);

const sortedPosts = await getSortedPosts(locale);
---

<Layout title={t(UI.home.greeting, locale)} description={t(UI.home.desc, locale)}>
  <Header />
  <main id="main-content" data-layout="index" data-backurl={`/${locale}/`} class="app-layout overflow-x-clip">
    <section id="hero" class="pt-10 pb-6">
      <h1 class="type-hero-title home-hero-title mt-4 mb-5 max-w-3xl sm:mt-8 sm:mb-6">
        {t(UI.home.greeting, locale)}
      </h1>
      <p class="type-body-lead max-w-2xl">{t(UI.home.desc, locale)}</p>
      {
        // only display if at least one social link is enabled
        SOCIALS.length > 0 && (
          <div class="mt-4 flex max-sm:flex-col sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">{t(UI.home.socialLinks, locale)}</div>
            <Socials />
          </div>
        )
      }
    </section>

    {
      sortedPosts.length > 0 && (
        <section id="recent-posts" class="line-frame border-t pt-6 pb-4">
          <h2 class="pane-title">{t(UI.home.recent, locale)}</h2>
          <ul class="mt-4 divide-y divide-soft">
            {sortedPosts.slice(0, SITE.postPerIndex).map(data => (
              <Card variant="h3" density="home" {...data} locale={locale} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="mt-6 mb-8 flex flex-wrap justify-start gap-4">
      <LinkButton href={`/${locale}/series/`}>
        {t(UI.home.seriesCta, locale)}
        <Icon name="tabler:arrow-right" class="inline-block rtl:-rotate-180" />
      </LinkButton>
      <LinkButton href={`/${locale}/posts/`}>
        {t(UI.home.allPosts, locale)}
        <Icon name="tabler:arrow-right" class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>
