---
import type { CollectionEntry } from "astro:content";
import BackButton from "@/components/BackButton.astro";
import BackToTopButton from "@/components/BackToTopButton.astro";
import CodeCopy from "@/components/CodeCopy.astro";
import CodeFolding from "@/components/CodeFolding.astro";
import Datetime from "@/components/Datetime.astro";
import FloatingTOC from "@/components/FloatingTOC.astro";
import Footer from "@/components/Footer.astro";
import Giscus from "@/components/Giscus.astro";
import Header from "@/components/Header.astro";
import Icon from "@/components/Icon.astro";
import ImageZoom from "@/components/ImageZoom.astro";
import LicenseInfo from "@/components/LicenseInfo.astro";
import ShareLinks from "@/components/ShareLinks.astro";
import Tag from "@/components/Tag.astro";
import { SITE } from "@/config";
import { UI } from "@/i18n/ui";
import { resolveLocale, t, tp } from "@/i18n/utils";
import Layout from "@/layouts/Layout.astro";
import { getPostUrl } from "@/utils/contentIdentity";
import { buildPostDetailsModel } from "@/utils/postDetailsModel";
import { slugifyStr } from "@/utils/slugify";

type Props = {
  post: CollectionEntry<"blog">;
  posts: CollectionEntry<"blog">[];
  translationMap: Record<string, string>;
};

const { post, posts, translationMap } = Astro.props;
const locale = resolveLocale(Astro.currentLocale);

const { title, pubDatetime, modDatetime, timezone, tags, license } = post.data;

const {
  Content,
  continuePosts,
  headings,
  kaTeXInlineCSS,
  katexPreloadFonts,
  layoutProps,
  nextPost,
  prevPost,
  wordCount,
} = await buildPostDetailsModel({ post, posts, translationMap, locale });
---

<Layout {...layoutProps}>
  {post.data.math && <style slot="head" set:html={kaTeXInlineCSS} />}
  {post.data.math && (
    <>
      {katexPreloadFonts.map(font => (
        <link slot="head" rel="preload" href={`/assets/fonts/katex/${font}`} as="font" type="font/woff2" crossorigin />
      ))}
    </>
  )}
  <Header />
  <BackButton />
  <main
    id="main-content"
    class:list={["app-layout overflow-x-clip pb-12", { "mt-8": !SITE.showBackButton }]}
    data-pagefind-body
    data-backurl={`/${locale}/`}
  >
    <div class="post-grid">
      <div class="min-w-0">
    <header class="pane-head">
      <h1
        transition:name={`p-${slugifyStr(title)}`}
        class="type-post-title mt-5 max-w-4xl"
      >
        {title}
      </h1>
      <div class="type-meta mt-4 flex flex-wrap items-center gap-x-3 gap-y-2" data-print-hide>
        <Datetime {pubDatetime} {modDatetime} {timezone} size="lg" />
        <span aria-hidden="true">·</span>
        <span>{tp(UI.post.wordsCount, locale, String(wordCount))}</span>
      </div>
    </header>
    <article
      id="article"
      class="app-prose mt-8 w-full"
    >
      <Content />
    </article>

      </div>

      <aside class="post-side hidden xl:block" data-pagefind-ignore data-print-hide>
        <FloatingTOC {headings} />
      </aside>
    </div>

    <hr class="line-section my-8" />

    <section class="grid gap-8 xl:grid-cols-2" data-pagefind-ignore data-print-hide>
      {
        continuePosts.length > 0 && (
          <div>
            <h2 class="pane-title">{t(UI.post.continueReading, locale)}</h2>
            <ul class="line-frame mt-4 border-b">
              {continuePosts.map(relatedPost => (
                <li class="line-frame border-t py-3">
                  <a class="tone-link-strong" href={getPostUrl(relatedPost, locale)}>{relatedPost.data.title}</a>
                  <p class="type-meta mt-1">{relatedPost.data.description}</p>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </section>


    <ul data-print-hide class="mt-4 mb-8 flex flex-wrap gap-4 sm:my-8">
      {tags.map(tag => <Tag tag={slugifyStr(tag)} tagName={tag} size="sm" />)}
    </ul>

    <BackToTopButton />

    <ShareLinks />

    <hr class="line-section my-6" />

    <LicenseInfo {license} />

    <!-- Previous/Next Post Buttons -->
    <div data-pagefind-ignore data-print-hide class="grid grid-cols-1 gap-6 sm:grid-cols-2">
      {
        prevPost && (
          <a
            href={prevPost.url}
            class="group justify-self-start"
          >
            <div class="hover-title inline-flex items-center gap-1">
              <Icon name="tabler:chevron-left" class="inline-block flex-none rtl:rotate-180" />
              <div>
                <span>{t(UI.post.prev, locale)}</span>
                <div class="type-meta text-accent">{prevPost.title}</div>
              </div>
            </div>
          </a>
        )
      }
      {
        nextPost && (
          <a
            href={nextPost.url}
            class="group justify-self-end sm:col-start-2"
          >
            <div class="hover-title inline-flex items-center gap-1 text-end">
              <div>
                <span>{t(UI.post.next, locale)}</span>
                <div class="type-meta text-accent">{nextPost.title}</div>
              </div>
              <Icon name="tabler:chevron-right" class="inline-block flex-none rtl:rotate-180" />
            </div>
          </a>
        )
      }
    </div>

    <Giscus />
  </main>
  <Footer />
  <ImageZoom />
  <CodeFolding />
  <CodeCopy />
</Layout>

<script src="../scripts/progress.ts"></script>

<style is:inline>
  .progress-bar {
    transition: width 150ms linear;
  }
</style>
