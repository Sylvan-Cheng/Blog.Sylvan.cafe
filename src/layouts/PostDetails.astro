---
import type { CollectionEntry } from "astro:content";
import BackButton from "@/components/BackButton.astro";
import BackToTopButton from "@/components/BackToTopButton.astro";
import CodeCopy from "@/components/CodeCopy.astro";
import CodeFolding from "@/components/CodeFolding.astro";
import FloatingTOC from "@/components/FloatingTOC.astro";
import Footer from "@/components/Footer.astro";
import Giscus from "@/components/Giscus.astro";
import Header from "@/components/Header.astro";
import ImageZoom from "@/components/ImageZoom.astro";
import LicenseInfo from "@/components/LicenseInfo.astro";
import PostMeta from "@/components/PostMeta.astro";
import PostNavigation from "@/components/PostNavigation.astro";
import ShareLinks from "@/components/ShareLinks.astro";
import Tag from "@/components/Tag.astro";
import { SITE } from "@/config";
import { resolveLocale } from "@/i18n/utils";
import Layout from "@/layouts/Layout.astro";
import type { PostIndex } from "@/utils/blogRepository";
import { buildPostDetailsModel } from "@/utils/postDetailsModel";
import { slugifyStr } from "@/utils/slugify";

type Props = {
  post: CollectionEntry<"blog">;
  postIndex: PostIndex;
};

const { post, postIndex } = Astro.props;
const locale = resolveLocale(Astro.currentLocale);

const { title, pubDatetime, modDatetime, timezone, tags, license, aiLabel } =
  post.data;

const {
  Content,
  headings,
  kaTeXInlineCSS,
  katexPreloadFonts,
  layoutProps,
  nextPost,
  prevPost,
  wordCount,
} = await buildPostDetailsModel({ post, postIndex, locale });
---

<Layout {...layoutProps}>
  {post.data.math && <style slot="head" set:html={kaTeXInlineCSS} />}
  {post.data.math && (
    <>
      {katexPreloadFonts.map(font => (
        <link slot="head" rel="preload" href={`/assets/fonts/katex/${font}`} as="font" type="font/woff2" crossorigin />
      ))}
    </>
  )}
  <Header />
  <BackButton />
  <main
    id="main-content"
    class:list={["app-layout overflow-x-clip pb-12", { "mt-8": !SITE.showBackButton }]}
    data-pagefind-body
    data-backurl={`/${locale}/`}
  >
    <div class="post-grid">
      <div class="min-w-0">
    <header class="pane-head">
      <h1
        transition:name={`p-${slugifyStr(title)}`}
        class="type-post-title mt-5 max-w-4xl"
      >
        {title}
      </h1>
      <PostMeta {locale} {pubDatetime} {modDatetime} {timezone} {wordCount} />
    </header>
    <article
      id="article"
      class="app-prose mt-8 w-full"
    >
      <Content />
    </article>

      </div>

      <aside class="post-side hidden xl:block" data-pagefind-ignore data-print-hide>
        <FloatingTOC {headings} />
      </aside>
    </div>

    <hr class="line-section my-8" />

    <ul data-print-hide class="mt-4 mb-8 flex flex-wrap gap-4 sm:my-8">
      {tags.map(tag => <Tag tag={slugifyStr(tag)} tagName={tag} size="sm" />)}
    </ul>

    <BackToTopButton />

    <ShareLinks />

    <hr class="line-frame my-6 border-t" />

    <LicenseInfo {license} />

    <PostNavigation {locale} {prevPost} {nextPost} />

    <Giscus />
  </main>
  <Footer {aiLabel} />
  <ImageZoom />
  <CodeFolding />
  <CodeCopy />
</Layout>

<script src="../scripts/progress.ts"></script>

<style is:inline>
  .progress-bar {
    transition: width 150ms linear;
  }
</style>
