---
import { type CollectionEntry, render } from "astro:content";
import fs from "fs";
import path from "path";
import BackButton from "@/components/BackButton.astro";
import BackToTopButton from "@/components/BackToTopButton.astro";
import CodeCopy from "@/components/CodeCopy.astro";
import CodeFolding from "@/components/CodeFolding.astro";
import Datetime from "@/components/Datetime.astro";
import FloatingTOC from "@/components/FloatingTOC.astro";
import Footer from "@/components/Footer.astro";
import Giscus from "@/components/Giscus.astro";
import Header from "@/components/Header.astro";
import Icon from "@/components/Icon.astro";
import ImageZoom from "@/components/ImageZoom.astro";
import LicenseInfo from "@/components/LicenseInfo.astro";
import ShareLinks from "@/components/ShareLinks.astro";
import Tag from "@/components/Tag.astro";
import { SITE } from "@/config";
import { UI } from "@/i18n/ui";
import { resolveLocale, t, tp } from "@/i18n/utils";
import Layout from "@/layouts/Layout.astro";
import { getOgImage } from "@/utils/getOgImage";
import { getPath } from "@/utils/getPath";
import { getPrevNextPosts } from "@/utils/getPrevNextPosts";
import { slugifyStr } from "@/utils/slugify";
import { countWords } from "@/utils/wordCount";

type Props = {
  post: CollectionEntry<"blog">;
  posts: CollectionEntry<"blog">[];
  translationMap: Record<string, string>;
};

const { post, posts, translationMap } = Astro.props;
const locale = resolveLocale(Astro.currentLocale);

const localizePostPath = (id: string, filePath?: string) =>
  `/${locale}${getPath(id, filePath)}`;

const {
  title,
  author,
  description,
  canonicalURL,
  pubDatetime,
  modDatetime,
  timezone,
  tags,
  license,
} = post.data;

const { Content, headings } = await render(post);
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);

const ogImageUrl = getOgImage(post, locale);
const ogImage = ogImageUrl
  ? new URL(ogImageUrl, Astro.url.origin).href
  : undefined;

const layoutProps = {
  title: `${title} | ${SITE.title}`,
  author,
  description,
  pubDatetime,
  modDatetime,
  canonicalURL,
  ogImage,
  hreflangs: translationMap,
};

const { prev: prevPost, next: nextPost } = getPrevNextPosts(posts, post.id);

const kaTeXInlineCSS = post.data.math
  ? fs.readFileSync(path.resolve("public/assets/katex.min.css"), "utf-8")
  : "";
---

<Layout {...layoutProps}>
  {post.data.math && <style slot="head" set:html={kaTeXInlineCSS} />}
  {post.data.math && (
    <>
      <link slot="head" rel="preload" href="/assets/fonts/katex/KaTeX_Main-Regular.woff2" as="font" type="font/woff2" crossorigin />
      <link slot="head" rel="preload" href="/assets/fonts/katex/KaTeX_Main-Bold.woff2" as="font" type="font/woff2" crossorigin />
      <link slot="head" rel="preload" href="/assets/fonts/katex/KaTeX_Math-Italic.woff2" as="font" type="font/woff2" crossorigin />
      <link slot="head" rel="preload" href="/assets/fonts/katex/KaTeX_Size1-Regular.woff2" as="font" type="font/woff2" crossorigin />
    </>
  )}
  <Header />
  <BackButton />
  <main
    id="main-content"
    class:list={["app-layout overflow-x-clip pb-12", { "mt-8": !SITE.showBackButton }]}
    data-pagefind-body
    data-backurl={`/${locale}/`}
  >
    <h1
      transition:name={`p-${slugifyStr(title)}`}
      class="inline-block text-2xl font-bold text-accent sm:text-3xl"
    >
      {title}
    </h1>
    <div class="my-2 flex items-center gap-2" data-print-hide>
      <Datetime {pubDatetime} {modDatetime} {timezone} size="lg" />
      <span aria-hidden="true" class="max-sm:hidden select-none opacity-40">&middot;</span>
      <span class="text-sm text-foreground opacity-60 max-sm:hidden">
        {tp(UI.post.wordsCount, locale, String(countWords(post.body ?? "")))}
      </span>

    </div>
    <article
      id="article"
      class="app-prose mt-8 w-full"
    >
      <Content />
    </article>

    <FloatingTOC headings={tocHeadings} />

    <hr class="my-8 border-dashed" />


    <ul data-print-hide class="mt-4 mb-8 flex flex-wrap gap-4 sm:my-8">
      {tags.map(tag => <Tag tag={slugifyStr(tag)} tagName={tag} size="sm" />)}
    </ul>

    <BackToTopButton />

    <ShareLinks />

    <hr class="my-6 border-dashed" />

    <LicenseInfo {license} />

    <!-- Previous/Next Post Buttons -->
    <div data-pagefind-ignore data-print-hide class="grid grid-cols-1 gap-6 sm:grid-cols-2">
      {
        prevPost && (
          <a
            href={localizePostPath(prevPost.id, prevPost.filePath)}
            class="group justify-self-start"
          >
            <div class="inline-flex items-center gap-1 group-hover:text-accent transition-colors duration-100">
              <Icon name="tabler:chevron-left" class="inline-block flex-none rtl:rotate-180" />
              <div>
                <span>{t(UI.post.prev, locale)}</span>
                <div class="text-sm text-accent/85">{prevPost.title}</div>
              </div>
            </div>
          </a>
        )
      }
      {
        nextPost && (
          <a
            href={localizePostPath(nextPost.id, nextPost.filePath)}
            class="group justify-self-end sm:col-start-2"
          >
            <div class="inline-flex items-center gap-1 text-end group-hover:text-accent transition-colors duration-100">
              <div>
                <span>{t(UI.post.next, locale)}</span>
                <div class="text-sm text-accent/85">{nextPost.title}</div>
              </div>
              <Icon name="tabler:chevron-right" class="inline-block flex-none rtl:rotate-180" />
            </div>
          </a>
        )
      }
    </div>

    <Giscus />
  </main>
  <Footer />
  <ImageZoom />
  <CodeFolding />
  <CodeCopy />
</Layout>

<script src="../scripts/progress.ts"></script>

<style is:inline>
  .progress-container {
    z-index: 10;
  }
  .progress-bar {
    transition: width 150ms linear;
  }
</style>
