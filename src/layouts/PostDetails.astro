---
import { render, type CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Tag from "@/components/Tag.astro";
import Datetime from "@/components/Datetime.astro";
import EditPost from "@/components/EditPost.astro";
import ShareLinks from "@/components/ShareLinks.astro";
import BackButton from "@/components/BackButton.astro";
import BackToTopButton from "@/components/BackToTopButton.astro";
import Giscus from "@/components/Giscus.astro";
import FloatingTOC from "@/components/FloatingTOC.astro";
import ImageZoom from "@/components/ImageZoom.astro";
import CodeFolding from "@/components/CodeFolding.astro";
import CodeCopy from "@/components/CodeCopy.astro";
import LicenseInfo from "@/components/LicenseInfo.astro";
import { getPath } from "@/utils/getPath";
import { slugifyStr } from "@/utils/slugify";
import { countWords } from "@/utils/wordCount";
import Icon from "@/components/Icon.astro";
import { SITE } from "@/config";
import { UI } from "@/i18n/ui";
import { resolveLocale, t } from "@/i18n/utils";
import fs from "fs";
import path from "path";

type Props = {
  post: CollectionEntry<"blog">;
  posts: CollectionEntry<"blog">[];
  translationMap: Record<string, string>;
};

const { post, posts, translationMap } = Astro.props;
const locale = resolveLocale(Astro.currentLocale);

const localizePostPath = (id: string, filePath?: string) =>
  `/${locale}${getPath(id, filePath)}`;

const {
  title,
  author,
  description,
  ogImage: initOgImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
  timezone,
  tags,
  hideEditPost,
  license,
} = post.data;

const { Content } = await render(post);

let ogImageUrl: string | undefined;

// Determine OG image source
if (typeof initOgImage === "string") {
  ogImageUrl = initOgImage; // Remote OG image (absolute URL)
} else if (initOgImage?.src) {
  ogImageUrl = initOgImage.src; // Local asset
}

// Use dynamic OG image if enabled and no remote|local ogImage
if (!ogImageUrl && SITE.dynamicOgImage) {
  ogImageUrl = `${localizePostPath(post.id, post.filePath)}index.png`;
}

// Resolve OG image URL (or fallback to SITE.ogImage / default `og.png`)
const ogImage = ogImageUrl
  ? new URL(ogImageUrl, Astro.url.origin).href
  : undefined;

const layoutProps = {
  title: `${title} | ${SITE.title}`,
  author,
  description,
  pubDatetime,
  modDatetime,
  canonicalURL,
  ogImage,
  scrollSmooth: true,
  hreflangs: translationMap,
};

/* ========== Prev/Next Posts ========== */

const allPosts = posts.map(({ data: { title }, id, filePath }) => ({
  id,
  title,
  filePath,
}));

const currentPostIndex = allPosts.findIndex(a => a.id === post.id);

const prevPost = currentPostIndex !== 0 ? allPosts[currentPostIndex - 1] : null;
const nextPost =
  currentPostIndex < allPosts.length - 1 ? allPosts[currentPostIndex + 1] : null;

const kaTeXInlineCSS = post.data.math
  ? fs.readFileSync(path.resolve("public/assets/katex.min.css"), "utf-8")
  : "";
---

<Layout {...layoutProps}>
  {post.data.math && <style slot="head" set:html={kaTeXInlineCSS} />}
  {post.data.math && (
    <>
      <link slot="head" rel="preload" href="/assets/fonts/katex/KaTeX_Main-Regular.woff2" as="font" type="font/woff2" crossorigin />
      <link slot="head" rel="preload" href="/assets/fonts/katex/KaTeX_Main-Bold.woff2" as="font" type="font/woff2" crossorigin />
      <link slot="head" rel="preload" href="/assets/fonts/katex/KaTeX_Math-Italic.woff2" as="font" type="font/woff2" crossorigin />
      <link slot="head" rel="preload" href="/assets/fonts/katex/KaTeX_Size1-Regular.woff2" as="font" type="font/woff2" crossorigin />
    </>
  )}
  {
    Object.keys(translationMap).length > 0 && (
      <script
        is:inline
        data-astro-rerun
        set:html={`window.__translations=${JSON.stringify(translationMap)};window.__currentLocale="${locale}";`}
      />
    )
  }
  <Header />
  <BackButton />
  <main
    id="main-content"
    class:list={["app-layout pb-12", { "mt-8": !SITE.showBackButton }]}
    data-pagefind-body
  >
    <FloatingTOC />
    <h1
      transition:name={`p-${slugifyStr(title)}`}
      class="inline-block text-2xl font-bold text-accent sm:text-3xl"
    >
      {title}
    </h1>
    <div class="my-2 flex items-center gap-2">
      <Datetime {pubDatetime} {modDatetime} {timezone} size="lg" />
      <span aria-hidden="true" class="max-sm:hidden select-none opacity-40">&middot;</span>
      <span class="text-sm text-foreground opacity-60 max-sm:hidden">
        {UI.post.wordsCount[locale](String(countWords(post.body ?? "")))}
      </span>
      <span
        aria-hidden="true"
        class:list={[
          "max-sm:hidden",
          { hidden: !SITE.editPost.enabled || hideEditPost },
        ]}>|</span
      >
      <EditPost {hideEditPost} {post} class="max-sm:hidden" />
    </div>
    <article
      id="article"
      class="app-prose mt-8 w-full max-w-app"
    >
      <Content />
    </article>

    <hr class="my-8 border-dashed" />

    <EditPost class="sm:hidden" {hideEditPost} {post} />

    <ul class="mt-4 mb-8 flex flex-wrap gap-4 sm:my-8">
      {tags.map(tag => <Tag tag={slugifyStr(tag)} tagName={tag} size="sm" />)}
    </ul>

    <BackToTopButton />

    <ShareLinks />

    <hr class="my-6 border-dashed" />

    <LicenseInfo {license} />

    <!-- Previous/Next Post Buttons -->
    <div data-pagefind-ignore class="grid grid-cols-1 gap-6 sm:grid-cols-2">
      {
        prevPost && (
          <a
            href={localizePostPath(prevPost.id, prevPost.filePath)}
            class="flex w-full gap-1 hover:opacity-75"
          >
            <Icon name="tabler:chevron-left" class="inline-block flex-none rtl:rotate-180" />
            <div>
              <span>{t(UI.post.prev, locale)}</span>
              <div class="text-sm text-accent/85">{prevPost.title}</div>
            </div>
          </a>
        )
      }
      {
        nextPost && (
          <a
            href={localizePostPath(nextPost.id, nextPost.filePath)}
            class="flex w-full justify-end gap-1 text-end hover:opacity-75 sm:col-start-2"
          >
            <div>
              <span>{t(UI.post.next, locale)}</span>
              <div class="text-sm text-accent/85">{nextPost.title}</div>
            </div>
            <Icon name="tabler:chevron-right" class="inline-block flex-none rtl:rotate-180" />
          </a>
        )
      }
    </div>

    <Giscus />
  </main>
  <Footer />
  <ImageZoom />
  <CodeFolding />
  <CodeCopy />
</Layout>

<script is:inline data-astro-rerun>
  /** Create a progress indicator at the top */
  function createProgressBar() {
    const existing = document.querySelector(".progress-container");
    if (existing) {
      existing.querySelector(".progress-bar").style.width = "0%";
      return;
    }
    const progressContainer = document.createElement("div");
    progressContainer.className =
      "progress-container fixed top-0 z-10 h-1 w-full bg-background";
    const progressBar = document.createElement("div");
    progressBar.className = "progress-bar h-1 w-0 bg-accent";
    progressBar.id = "myBar";
    progressContainer.appendChild(progressBar);
    document.body.appendChild(progressContainer);
  }
  createProgressBar();

  /** Update the progress bar when user scrolls */
  function updateScrollProgress() {
    if (window.__scrollBound) return;
    window.__scrollBound = true;
    let ticking = false;
    document.addEventListener("scroll", () => {
      if (!ticking) {
        requestAnimationFrame(() => {
          const myBar = document.getElementById("myBar");
          if (!myBar) { ticking = false; return; }
          const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
          const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
          if (height <= 0) { myBar.style.width = "0%"; ticking = false; return; }
          myBar.style.width = (winScroll / height) * 100 + "%";
          ticking = false;
        });
        ticking = true;
      }
    }, { passive: true });
  }
  updateScrollProgress();

  /* Go to page start after page swap */
  if (!window.__scrollTopBound) {
    window.__scrollTopBound = true;
    document.addEventListener("astro:after-swap", () => {
      if (!document.getElementById("main-content")) return;
      window.scrollTo({ left: 0, top: 0, behavior: "instant" });
    });
  }
</script>
