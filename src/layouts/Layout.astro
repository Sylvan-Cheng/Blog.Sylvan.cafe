---
import { PUBLIC_GOOGLE_SITE_VERIFICATION } from "astro:env/client";
import { ClientRouter } from "astro:transitions";
import { SITE, THEME_DEFS } from "@/config";
import { LOCALE_META, LOCALES } from "@/i18n/config";
import { UI } from "@/i18n/ui";
import { resolveLocale, t } from "@/i18n/utils";
import {
  buildHreflangPath,
  buildStructuredData,
  getDefaultOgImage,
  serializeJsonLd,
} from "@/utils/layoutSeo";
import "@/styles/global.css";
import "@fontsource/noto-sans/latin-400.css";
import "@fontsource/noto-sans/latin-700.css";
import "@fontsource/noto-sans/cyrillic-400.css";
import "@fontsource/noto-sans/cyrillic-700.css";
import "@fontsource/noto-sans-sc/chinese-simplified-400.css";
import "@fontsource/noto-sans-sc/chinese-simplified-700.css";
import "@fontsource/noto-sans-jp/japanese-400.css";
import "@fontsource/noto-sans-jp/japanese-700.css";
import "@fontsource/fira-code/latin-400.css";

import cyrillic400 from "@fontsource/noto-sans/files/noto-sans-cyrillic-400-normal.woff2";
// Preload font assets via Vite to get hashed URLs for <link rel="preload">
import latin400 from "@fontsource/noto-sans/files/noto-sans-latin-400-normal.woff2";
import latin700 from "@fontsource/noto-sans/files/noto-sans-latin-700-normal.woff2";
import jp400 from "@fontsource/noto-sans-jp/files/noto-sans-jp-japanese-400-normal.woff2";
import sc400 from "@fontsource/noto-sans-sc/files/noto-sans-sc-chinese-simplified-400-normal.woff2";

// Map locale → additional script font to preload
const scriptFont: Record<string, string> = {
  zh: sc400,
  ja: jp400,
  ru: cyrillic400,
};

type Props = {
  title?: string;
  author?: string;
  profile?: string;
  description?: string;
  pubDatetime?: Date;
  modDatetime?: Date | null;
  hreflangs?: Record<string, string>;
};

const {
  title = SITE.title,
  author = SITE.author,
  profile = SITE.profile,
  description = SITE.desc,
  pubDatetime,
  modDatetime,
  hreflangs,
} = Astro.props;

const locale = resolveLocale(Astro.currentLocale);
const currentPath = Astro.url.pathname;
const canonicalURL = new URL(currentPath, Astro.url);

const hreflangUrl = (targetLocale: string) =>
  buildHreflangPath(currentPath, targetLocale, hreflangs);

const socialImageURL = new URL(getDefaultOgImage(), Astro.url);

const structuredData = buildStructuredData({
  title,
  author,
  profile,
  description,
  socialImageURL,
  canonicalURL,
  locale,
  pubDatetime,
  modDatetime,
});

const themeColors = THEME_DEFS[SITE.themeScheme].themeColor;
---

<!--
   _____       _
  / ____|     | |
 | (___  _   _| |_   ____ _ _ __
  \___ \| | | | \ \ / / _` | '_ \
  ____) | |_| | |\ V / (_| | | | |
 |_____/ \__, |_| \_/ \__,_|_| |_|
          __/ |
         |___/
-->
<!doctype html>
<html
  dir={SITE.dir}
  data-scheme={SITE.themeScheme}
  lang={LOCALE_META[locale].lang}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <!-- Preconnect to Umami analytics early -->
    <link rel="preconnect" href={SITE.analytics.umami.url} crossorigin />
    <link rel="dns-prefetch" href={SITE.analytics.umami.url} />

    <!-- Preconnect to Giscus comments -->
    <link rel="preconnect" href="https://giscus.app" crossorigin />

    <!-- Preload critical fonts to reduce CLS -->
    <link rel="preload" href={latin400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={latin700} as="font" type="font/woff2" crossorigin />
    {
      scriptFont[locale] && (
        <link rel="preload" href={scriptFont[locale]} as="font" type="font/woff2" crossorigin />
      )
    }

    <!-- hreflang tags for multilingual SEO -->
    {
      LOCALES.map(target => (
        <link
          rel="alternate"
          hreflang={LOCALE_META[target].lang}
          href={new URL(hreflangUrl(target), Astro.site)}
        />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(hreflangUrl(LOCALES[0]), Astro.site)}
    />

    <!-- General Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="llms-txt" href="/llms.txt" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={pubDatetime ? "article" : "website"} />
    <meta property="og:locale" content={LOCALE_META[locale].lang} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />

    <!-- Article Published/Modified time -->
    {
      pubDatetime && (
        <meta
          property="article:published_time"
          content={pubDatetime.toISOString()}
        />
      )
    }
    {
      modDatetime && (
        <meta
          property="article:modified_time"
          content={modDatetime.toISOString()}
        />
      )
    }

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={socialImageURL} />

    <!-- Google JSON-LD Structured data (only for blog posts) -->
    {
      structuredData && (
        <script
          type="application/ld+json"
          is:inline
          set:html={serializeJsonLd(structuredData)}
        />
      )
    }

    <!-- Enable RSS feed auto-discovery -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE.title}
      href={new URL(`${locale}/rss.xml`, Astro.site)}
    />

    <meta name="theme-color" content="" />

    {
      // If PUBLIC_GOOGLE_SITE_VERIFICATION is set in the environment variable,
      // include google-site-verification tag in the heading
      // Learn more: https://support.google.com/webmasters/answer/9008080#meta_tag_verification&zippy=%2Chtml-tag
      PUBLIC_GOOGLE_SITE_VERIFICATION && (
        <meta
          name="google-site-verification"
          content={PUBLIC_GOOGLE_SITE_VERIFICATION}
        />
      )
    }

    <ClientRouter />

    <!-- Umami Analytics (Partytown) -->
    <script is:inline type="text/partytown" src={`${SITE.analytics.umami.url}/script.js`} data-website-id={SITE.analytics.umami.websiteId}></script>

    <!-- Minimal inline script to prevent FOUC - sets theme immediately -->
    <script is:inline define:vars={{ themeColors }}>
      (function () {
        const initialColorScheme = ""; // "light" | "dark"
        const currentTheme = localStorage.getItem("theme");

        function getPreferTheme() {
          if (currentTheme) return currentTheme;
          if (initialColorScheme) return initialColorScheme;
          return window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light";
        }

        const themeValue = getPreferTheme();

        // Set theme immediately to prevent flash
        document.firstElementChild?.setAttribute("data-theme", themeValue);
        localStorage.removeItem("theme-scheme");

        // 同步设置浏览器地址栏颜色，避免 Android Chrome 暗色模式闪白
        document.querySelector("meta[name='theme-color']")
          ?.setAttribute("content", themeColors[themeValue] || "");

        // 合并现有 API（视图过渡时保留 theme.ts 扩展的方法）
        window.theme = {
          ...(window.theme || {}),
          themeValue: themeValue,
          getTheme: () => window.theme.themeValue,
          setTheme: val => {
            window.theme.themeValue = val;
          },
        };
      })();
    </script>
    <slot name="head" />
  </head>
  <body data-reading-progress-label={t(UI.readingProgress, locale)}>
    <slot />

    <!-- Load full theme logic -->
    <script src="../scripts/theme.ts"></script>
  </body>
</html>
