---
import Breadcrumb from "@/components/Breadcrumb.astro";
import { SITE } from "@/config";

type StringTitle = { pageTitle: string };
type ArrayTitle = { pageTitle: [string, string]; titleTransition: string };

type Props = (StringTitle | ArrayTitle) & { pageDesc?: string };

const { props } = Astro;

const backUrl = SITE.showBackButton ? Astro.url.pathname : "/";
---

<Breadcrumb />
<main data-backurl={backUrl} id="main-content" class="app-layout overflow-x-clip pb-4">
  <header class="pane-head">
    {
      "titleTransition" in props ? (
        <h1 class="type-page-title">
          {props.pageTitle[0]}
          <span transition:name={`p-${props.titleTransition}`}>
            {props.pageTitle[1]}
          </span>
        </h1>
      ) : (
        <h1 class="type-page-title">{props.pageTitle}</h1>
      )
    }
    {props.pageDesc && <p class="pane-sub">{props.pageDesc}</p>}
  </header>
  <slot />
</main>
