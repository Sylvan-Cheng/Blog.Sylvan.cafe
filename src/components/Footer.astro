---
import type { HTMLAttributes } from "astro/types";
import type { Locale } from "@/i18n/config";
import { resolveLocale } from "@/i18n/utils";
import AILabel, { type AILabelType } from "./AILabel.astro";
import Socials from "./Socials.astro";

const currentYear = new Date().getFullYear();

type Props = {
  locale?: Locale;
  noMarginTop?: boolean;
  aiLabel?: AILabelType;
} & HTMLAttributes<"footer">;

const {
  locale: localeOverride,
  noMarginTop = false,
  aiLabel = "assisted-by-ai",
  class: className,
  ...attrs
} = Astro.props;
const locale = localeOverride ?? resolveLocale(Astro.currentLocale);
---

<footer
  class:list={["app-layout", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div
    class:list={[
      "py-6 sm:py-4",
      "line-frame border-t",
      "flex flex-col items-center gap-4 sm:flex-row sm:justify-between",
    ]}
  >
    <div
      class="my-2 flex flex-col items-center whitespace-nowrap text-sm text-text-secondary sm:flex-row order-last sm:order-none"
    >
      <span>Copyright &#169; {currentYear} Sylvan</span>
      <span class="hidden sm:inline">&nbsp;|&nbsp;</span>
      <span>Some rights reserved.</span>
      <span class="hidden sm:inline">&nbsp;|&nbsp;</span>
      <a href={`/${locale}/license`} class="hover-accent">License</a>
    </div>
    <AILabel label={aiLabel} locale={locale} />
    <div class="order-first sm:order-none xl:hidden">
      <Socials locale={locale} />
    </div>
  </div>
</footer>
