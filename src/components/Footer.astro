---
import type { HTMLAttributes } from "astro/types";
import type { Locale } from "@/i18n/config";
import { resolveLocale } from "@/i18n/utils";
import AILabel, { type AILabelType } from "./AILabel.astro";
import Socials from "./Socials.astro";

const currentYear = new Date().getFullYear();

type Props = {
  locale?: Locale;
  noMarginTop?: boolean;
  aiLabel?: AILabelType;
} & HTMLAttributes<"footer">;

const {
  locale: localeOverride,
  noMarginTop = false,
  aiLabel = "assisted-by-ai",
  class: className,
  ...attrs
} = Astro.props;
const locale = localeOverride ?? resolveLocale(Astro.currentLocale);
---

<footer
  class:list={["app-layout", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div
    class:list={[
      "py-4",
      "line-frame border-t",
      "flex flex-col items-center gap-2 sm:flex-row sm:justify-between sm:gap-4",
    ]}
  >
    <div class="order-first flex items-center justify-center gap-3 sm:contents">
      <div class="xl:hidden sm:order-3">
        <Socials locale={locale} />
      </div>
      <div class="sm:order-2">
        <AILabel label={aiLabel} locale={locale} />
      </div>
    </div>
    <div
      class="order-last flex flex-wrap items-center justify-center gap-x-1.5 gap-y-1 text-center text-xs text-text-secondary sm:order-1 sm:flex-nowrap sm:whitespace-nowrap sm:text-sm"
    >
      <span class="sm:hidden">&#169; {currentYear} Sylvan</span>
      <span class="hidden sm:inline">Copyright &#169; {currentYear} Sylvan</span>
      <span aria-hidden="true">|</span>
      <span>Some rights reserved.</span>
      <span aria-hidden="true">|</span>
      <a href={`/${locale}/license`} class="hover-accent">License</a>
    </div>
  </div>
</footer>
