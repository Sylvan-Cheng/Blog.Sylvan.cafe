---
import { UI } from "@/i18n/ui";
// import Tooltip from "@/components/Tooltip.astro";
import { resolveLocale, t } from "@/i18n/utils";
import enSvg from "../assets/badges/not-by-ai/en.svg?raw";
import eoSvg from "../assets/badges/not-by-ai/eo.svg?raw";
import jaSvg from "../assets/badges/not-by-ai/ja.svg?raw";
import ruSvg from "../assets/badges/not-by-ai/ru.svg?raw";
import zhSvg from "../assets/badges/not-by-ai/zh.svg?raw";

const locale = resolveLocale(Astro.currentLocale);

const svgMap: Record<string, string> = {
  zh: zhSvg,
  en: enSvg,
  ja: jaSvg,
  ru: ruSvg,
  eo: eoSvg,
};

const svg = (svgMap[locale] ?? "")
  .replace(/width="[^"]*"/, "")
  .replace(/height="[^"]*"/, "")
  .replace(/viewBox="[^"]*"/, 'viewBox="-1 -1 133 44"')
  .replace(/stroke="currentColor"/, 'stroke="currentColor" stroke-width="2"');
---

<!-- <Tooltip text={t(UI.notByAI, locale)}> -->
  <a
    href="https://notbyai.fyi"
    target="_blank"
    rel="noopener"
    aria-label={t(UI.notByAI, locale)}
    class="inline-flex items-center text-foreground hover:text-accent transition-colors duration-200 h-6"
  >
    <span class="h-full w-auto" set:html={svg} />
  </a>
<!-- </Tooltip> -->
