---
import { UI } from "@/i18n/ui";
import { resolveLocale, t } from "@/i18n/utils";

const locale = resolveLocale(Astro.currentLocale);
const labelCopy = t(UI.codeBlock.copy, locale);
const labelCopied = t(UI.codeBlock.copied, locale);
---

<style is:global>
  .copy-btn {
    position: absolute;
    right: 0.75rem;
    border-radius: 0.25rem;
    background: var(--color-muted);
    border: 1px solid var(--color-border);
    padding: 0.25rem 0.5rem;
    font-size: 0.75rem;
    line-height: 1rem;
    color: var(--color-foreground);
    font-weight: 500;
    font-family: var(--font-body);
    transition: background-color 150ms ease-out;
  }

  .copy-btn:hover,
  .copy-btn:focus-visible {
    background: var(--color-border);
  }
</style>

<div hidden data-code-copy-labels data-label-copy={labelCopy} data-label-copied={labelCopied}></div>
<script src="../scripts/code-copy.ts"></script>
