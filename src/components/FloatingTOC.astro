---
import Icon from "@/components/Icon.astro";
import { UI } from "@/i18n/ui";
import { resolveLocale, t } from "@/i18n/utils";

const locale = resolveLocale(Astro.currentLocale);
---

<nav
  id="floating-toc"
  aria-label={t(UI.toc, locale)}
  data-footnotes-label={t(UI.footnotes, locale)}
  class="fixed top-24 hidden w-48 xl:block"
  style="left: min(calc(50% + var(--toc-offset-content, 26rem)), calc(100vw - var(--toc-offset-edge, 14rem)));"
>
  <div class="border-s-2 border-accent/30 ps-3">
    <div
      class="mb-2 flex items-center gap-1.5 text-xs font-semibold text-foreground/70"
    >
      <Icon name="tabler:list-tree" class="inline-block size-3.5" />
      <span>{t(UI.toc, locale)}</span>
    </div>
    <div class="relative">
      <div
        id="toc-fade-top"
        class="pointer-events-none absolute top-0 left-0 right-0 z-10 hidden h-6 bg-gradient-to-b from-background to-transparent"
      >
      </div>
      <div
        id="toc-fade-bottom"
        class="pointer-events-none absolute bottom-0 left-0 right-0 z-10 hidden h-6 bg-gradient-to-t from-background to-transparent"
      >
      </div>
      <ul
        id="toc-list"
        class="space-y-1 text-sm leading-relaxed overflow-y-auto"
        style="max-height: calc(100vh - var(--toc-offset-edge, 14rem))"
      >
      </ul>
    </div>
  </div>
</nav>

<style is:inline>
  #floating-toc {
    --toc-offset-content: 26rem;
    --toc-offset-edge: 14rem;
  }

  #toc-list {
    scrollbar-width: none;
    scroll-padding-top: 1.5rem;
    scroll-padding-bottom: 1.5rem;
    overscroll-behavior: contain;
  }
  #toc-list::-webkit-scrollbar {
    display: none;
  }
</style>

<script is:inline data-astro-rerun>
  function buildTOC() {
    const article = document.getElementById("article");
    const tocContainer = document.getElementById("floating-toc");
    const tocList = document.getElementById("toc-list");
    if (!article || !tocContainer || !tocList) return;

    const headings = Array.from(article.querySelectorAll("h2, h3"));
    if (headings.length < 2) {
      tocContainer.style.display = "none";
      return;
    }

    const HEADING_SCROLL_OFFSET = 80;
    const TOOLTIP_EDGE = 8;

    // 清理上一页的 observer 和 scroll 监听
    window.__toc ??= {};
    if (window.__toc.observer) {
      window.__toc.observer.disconnect();
    }
    if (window.__toc.scrollHandler) {
      document.removeEventListener("scroll", window.__toc.scrollHandler);
      window.__toc.scrollHandler = null;
    }
    if (window.__toc.hideTimeout) {
      clearTimeout(window.__toc.hideTimeout);
      window.__toc.hideTimeout = null;
    }

    // 清理上一页残留的 tooltip（使用专属容器）
    let tooltipRoot = document.getElementById("toc-tooltip-root");
    if (tooltipRoot) {
      tooltipRoot.innerHTML = "";
    } else {
      tooltipRoot = document.createElement("div");
      tooltipRoot.id = "toc-tooltip-root";
      document.body.appendChild(tooltipRoot);
    }

    // 清空现有列表
    tocList.innerHTML = "";

    // 确保所有标题都有 ID（Astro 会自动生成）
    headings.forEach((heading, i) => {
      if (!heading.id) {
        heading.id =
          heading.textContent
            ?.trim()
            .replace(/[^\p{L}\p{N}]+/gu, "-")
            .replace(/^-|-$/g, "") || `heading-${i}`;
      }
    });

    // 构建目录项（tooltip 后续仅为截断文本附加）
    const fragment = document.createDocumentFragment();
    headings.forEach((heading) => {
      const li = document.createElement("li");
      const a = document.createElement("a");
      a.href = `#${heading.id}`;
      // 去除 PostDetails 中 addHeadingLinks 追加的尾部 "#"
      const rawLabel = heading.textContent?.replace(/\s*#\s*$/, "").trim() || "";
      const label = heading.id === "footnote-label" ? tocContainer.dataset.footnotesLabel || rawLabel : rawLabel;
      a.className = `block border-s-2 py-1 pe-2 transition-all duration-200 hover:text-accent hover:translate-x-0.5 ${
        heading.tagName === "H3" ? "ps-6" : "ps-3"
      } text-foreground/60 border-transparent hover:border-accent/40`;

      const textSpan = document.createElement("span");
      textSpan.className = `block truncate${heading.tagName === "H3" ? " text-xs" : ""}`;
      textSpan.textContent = label;

      a.appendChild(textSpan);

      li.appendChild(a);
      fragment.appendChild(li);
    });
    tocList.appendChild(fragment);

    // 点击委托：点击目录项滚动到对应标题
    tocList.addEventListener("click", (e) => {
      const a = e.target.closest("a");
      if (!a) return;
      e.preventDefault();
      const id = a.getAttribute("href")?.slice(1);
      if (!id) return;
      const target = document.getElementById(id);
      if (target) {
        const top =
          target.getBoundingClientRect().top +
          window.scrollY -
          HEADING_SCROLL_OFFSET;
        window.scrollTo({ top, behavior: "smooth" });
        history.replaceState(null, "", `#${id}`);
      }
    });

    // 仅为文本被截断的标题附加 tooltip（读/写两阶段分离，避免交替重排）
    const tocItems = tocList.querySelectorAll("li a");
    const tooltipMap = new WeakMap();

    function initTooltips() {
      // 阶段 1：收集所有截断检查（纯读）
      const truncated = [];
      tocItems.forEach((a) => {
        const textSpan = a.querySelector("span.block.truncate");
        if (!textSpan) return;
        if (textSpan.scrollWidth > textSpan.clientWidth) {
          const href = a.getAttribute("href") || "";
          truncated.push({ a, headingId: href.slice(1), label: textSpan.textContent || "" });
        }
      });
      // 阶段 2：创建 tooltip 并批量测量（先写入再读取，一次布局计算）
      const tooltips = [];
      truncated.forEach(({ a, headingId, label }) => {
        const tooltip = document.createElement("span");
        tooltip.id = `toc-tooltip-${headingId}`;
        tooltip.role = "tooltip";
        tooltip.textContent = label;
        tooltip.className =
          "toc-dynamic-tooltip pointer-events-none fixed z-[9999] w-max max-w-[200px] whitespace-normal rounded bg-foreground px-2 py-1 text-xs text-background opacity-0 shadow-md transition-opacity duration-200";
        tooltip.style.display = "block";
        tooltipRoot.appendChild(tooltip);
        tooltipMap.set(a, tooltip);
        tooltips.push(tooltip);
      });
      // 阶段 3：批量测量尺寸（所有写入完成后统一读取，避免重复重排）
      for (const tooltip of tooltips) {
        const d = tooltip.getBoundingClientRect();
        tooltip._width = d.width;
        tooltip._height = d.height;
        tooltip.style.display = "none";
      }
    }

    // 父容器上的委托鼠标事件
    let currentLink = null;
    let timeoutId = null;
    let rafId = null;

    function hideTooltip() {
      if (!currentLink) return;
      const t = tooltipMap.get(currentLink);
      if (t) {
        clearTimeout(timeoutId);
        if (rafId) {
          cancelAnimationFrame(rafId);
          rafId = null;
        }
        t.style.opacity = "0";
        window.__toc.hideTimeout = setTimeout(() => {
          if (t.style.opacity === "0") t.style.display = "none";
          window.__toc.hideTimeout = null;
        }, 200);
      }
      currentLink = null;
    }

    tocList.addEventListener("mouseover", (e) => {
      const a = e.target.closest("li a");
      if (!a || a === currentLink) return;
      hideTooltip();
      const tooltip = tooltipMap.get(a);
      if (!tooltip) {
        currentLink = null;
        return;
      }
      currentLink = a;
      tooltip.style.display = "block";
      timeoutId = window.setTimeout(() => {
        tooltip.style.opacity = "1";
      }, 400);
    });

    tocList.addEventListener("mousemove", (e) => {
      if (!currentLink) return;
      if (rafId) return;
      const link = currentLink;
      const { clientX, clientY } = e;
      rafId = requestAnimationFrame(() => {
        const t = tooltipMap.get(link);
        if (t) {
          const w = t._width || 200;
          const h = t._height || 50;
          let left = clientX + 12;
          let top = clientY + 15;
          left = Math.max(
            TOOLTIP_EDGE,
            Math.min(
              left,
              document.documentElement.clientWidth - w - TOOLTIP_EDGE,
            ),
          );
          top = Math.max(
            TOOLTIP_EDGE,
            Math.min(
              top,
              document.documentElement.clientHeight - h - TOOLTIP_EDGE,
            ),
          );
          t.style.left = `${left}px`;
          t.style.top = `${top}px`;
        }
        rafId = null;
      });
    });

    tocList.addEventListener("mouseout", (e) => {
      const a = e.target.closest("li a");
      if (!a || a !== currentLink) return;
      // 鼠标移到同一链接的子元素时忽略
      if (e.relatedTarget && a.contains(e.relatedTarget)) return;
      hideTooltip();
    });

    // 淡出遮罩 — 隐藏滚动条时指示可滚动溢出
    const topFade = document.getElementById("toc-fade-top");
    const bottomFade = document.getElementById("toc-fade-bottom");

    function updateFadeEdges() {
      if (!topFade || !bottomFade) return;
      if (tocList.scrollHeight <= tocList.clientHeight) {
        topFade.classList.add("hidden");
        bottomFade.classList.add("hidden");
        return;
      }
      topFade.classList.toggle("hidden", tocList.scrollTop <= 0);
      const atBottom =
        tocList.scrollTop + tocList.clientHeight >= tocList.scrollHeight - 2;
      bottomFade.classList.toggle("hidden", atBottom);
    }

    if (topFade && bottomFade) {
      tocList.addEventListener("scroll", updateFadeEdges, { passive: true });
    }

    // 使用 IntersectionObserver 实现滚动监听
    const tocLinks = Array.from(tocItems);

    let activeId = headings[0]?.id || null;

    function updateActiveLink() {
      let activeLink = null;
      for (const link of tocLinks) {
        const href = link.getAttribute("href");
        if (!href) continue;
        const id = href.slice(1);
        const isActive = id === activeId;
        link.classList.toggle("text-accent", isActive);
        link.classList.toggle("font-semibold", isActive);
        link.classList.toggle("border-accent/60", isActive);
        link.classList.toggle("text-foreground/60", !isActive);
        link.classList.toggle("border-transparent", !isActive);
        if (isActive) activeLink = link;
      }
      if (activeLink) {
        activeLink.scrollIntoView({ block: "nearest", behavior: "smooth" });
      }
    }

    window.__toc.observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            activeId = entry.target.id;
          }
        }
        updateActiveLink();
      },
      {
        // HEADING_SCROLL_OFFSET: 顶部 header + 文章内边距；-65%: 标题在视口上方约 35% 区域内时激活
        rootMargin: `-${HEADING_SCROLL_OFFSET}px 0px -65% 0px`,
        threshold: 0,
      },
    );

    for (const heading of headings) {
      window.__toc.observer.observe(heading);
    }

    // 推迟所有布局读取到下一帧，避免强制同步重排
    requestAnimationFrame(() => {
      // 页面可能已导航离开，检查 DOM 是否仍然存活
      if (!document.getElementById("article")) return;
      initTooltips();
      updateFadeEdges();
      // 推断正确的激活标题
      for (let i = headings.length - 1; i >= 0; i--) {
        if (headings[i].getBoundingClientRect().top <= HEADING_SCROLL_OFFSET) {
          activeId = headings[i].id;
          break;
        }
      }
      updateActiveLink();
    });

    // 页面底部检测：用户滚到最底部时激活最后一个标题
    window.__toc.scrollHandler = function () {
      const atBottom =
        window.innerHeight + window.scrollY >=
        document.documentElement.scrollHeight - 10;
      if (atBottom) {
        const lastHeading = headings[headings.length - 1];
        if (lastHeading && activeId !== lastHeading.id) {
          activeId = lastHeading.id;
          updateActiveLink();
        }
      }
    };
    document.addEventListener("scroll", window.__toc.scrollHandler, {
      passive: true,
    });
  }

  document.addEventListener("astro:page-load", () => requestAnimationFrame(buildTOC));
</script>
