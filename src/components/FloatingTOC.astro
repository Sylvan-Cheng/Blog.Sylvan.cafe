---
import Icon from "@/components/Icon.astro";
import { UI } from "@/i18n/ui";
import { resolveLocale, t } from "@/i18n/utils";

interface MarkdownHeading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;
const locale = resolveLocale(Astro.currentLocale);
const tocHeadings = (headings ?? []).filter(h => h.depth === 2 || h.depth === 3);
---

{tocHeadings.length >= 2 && (
  <nav
    id="floating-toc"
    aria-label={t(UI.toc, locale)}
    class="fixed top-24 hidden w-48 xl:block"
    style="left: min(calc(50% + var(--toc-offset-content, 26rem)), calc(100vw - var(--toc-offset-edge, 14rem)));"
  >
    <div class="border-s-2 border-accent/30 ps-3">
      <div class="mb-2 flex items-center gap-1.5 text-xs font-semibold text-foreground/70">
        <Icon name="tabler:list-tree" class="inline-block size-3.5" />
        <span>{t(UI.toc, locale)}</span>
      </div>
      <div class="relative">
        <div
          id="toc-fade-top"
          class="pointer-events-none absolute top-0 left-0 right-0 z-10 hidden h-6 bg-gradient-to-b from-background to-transparent"
        >
        </div>
        <div
          id="toc-fade-bottom"
          class="pointer-events-none absolute bottom-0 left-0 right-0 z-10 h-6 bg-gradient-to-t from-background to-transparent"
        >
        </div>
        <ul
          id="toc-list"
          class="space-y-1 text-sm leading-relaxed overflow-y-auto"
          style="max-height: calc(100vh - var(--toc-offset-edge, 14rem))"
        >
          {tocHeadings.map((h, idx) => {
            const isH3 = h.depth === 3;
            const label = h.slug === "footnote-label"
              ? t(UI.footnotes, locale)
              : h.text.replace(/\s*#+$/, "");
            const isFirst = idx === 0;
            return (
              <li>
                <a
                  href={`#${h.slug}`}
                  class={`block border-s-2 py-1 pe-2 transition duration-200 origin-left hover:text-accent hover:border-accent/40 hover:scale-[1.02] ${isH3 ? "ps-6" : "ps-3"} ${isFirst ? "text-accent font-semibold border-accent/60" : "text-foreground/60 border-transparent"}`}
                >
                  <span class={`block truncate${isH3 ? " text-xs" : ""}`}>
                    {label}
                  </span>
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    </div>
  </nav>
)}

<style is:inline>
  #floating-toc {
    --toc-offset-content: 26rem;
    --toc-offset-edge: 14rem;
  }

  #toc-list {
    scrollbar-width: none;
    scroll-padding-top: 1.5rem;
    scroll-padding-bottom: 1.5rem;
    overscroll-behavior: contain;
  }
  #toc-list::-webkit-scrollbar {
    display: none;
  }
</style>

<script src="../scripts/toc.ts"></script>
