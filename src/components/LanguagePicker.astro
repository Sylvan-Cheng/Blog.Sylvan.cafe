---
import { Icon } from "astro-icon/components";
import { LOCALE_META, LOCALES } from "@/i18n/config";
import { UI } from "@/i18n/ui";
import { resolveLocale, t } from "@/i18n/utils";

const currentLocale = resolveLocale(Astro.currentLocale);
const pathname = Astro.url.pathname;

const locales = LOCALES.map((code) => ({
  code,
  label: LOCALE_META[code].label,
}));

function switchLocale(path: string, to: string): string {
  if (path === "/") return `/${to}/`;
  const replaced = path.replace(/^\/([a-z]{2})(\/|$)/, `/${to}$2`);
  return replaced.endsWith("/") ? replaced : `${replaced}/`;
}

const items = locales.map(({ code, label }) => ({
  code,
  label,
  url: switchLocale(pathname, code),
}));
---

<div class="relative inline-flex">
    <button
      id="lang-trigger"
      class="flex p-3 sm:p-1 hover:text-accent text-foreground transition-colors duration-200"
      aria-label={t(UI.selectLanguage, currentLocale)}
      aria-expanded="false"
      aria-haspopup="listbox"
    >
      <Icon name="tabler:language" size={24} />
    </button>

  <ul
    id="lang-dropdown"
    class="absolute top-full right-0 z-50 mt-1 min-w-[120px] list-none rounded-md border border-border bg-background py-1 shadow-lg"
    role="listbox"
    hidden
  >
    {
      items.map(({ code, label, url }) => (
        <li role="option" aria-selected={code === currentLocale}>
          <a
            href={url}
            data-locale={code}
            class:list={[
              "block px-3 py-1.5 text-sm no-underline whitespace-nowrap transition-colors duration-200",
              "hover:bg-muted",
              code === currentLocale
                ? "text-accent font-semibold"
                : "text-foreground",
            ]}
          >
            {label}
          </a>
        </li>
      ))
    }
  </ul>
</div>

<script src="../scripts/lang.ts"></script>
