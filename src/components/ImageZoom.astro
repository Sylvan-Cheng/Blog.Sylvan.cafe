<script is:inline>
  var zoomInstance = null;
  var zoomLoading = false;
  var clickHandler = null;

  async function loadZoom() {
    if (zoomInstance || zoomLoading) return;
    zoomLoading = true;
    var images = document.querySelectorAll(".app-prose img:not(a img)");
    if (images.length === 0) { zoomLoading = false; return; }

    var mediumZoomModule = await import("medium-zoom");
    zoomInstance = mediumZoomModule.default(images, { margin: 24 });
    zoomLoading = false;
  }

  function destroyImageZoom() {
    if (zoomInstance) {
      zoomInstance.detach();
      zoomInstance = null;
    }
    zoomLoading = false;
    if (clickHandler) {
      var article = document.getElementById("article");
      if (article) article.removeEventListener("click", clickHandler);
      clickHandler = null;
    }
  }

  function initImageZoom() {
    destroyImageZoom();

    var article = document.getElementById("article");
    if (!article) return;

    if (!document.querySelector(".app-prose img:not(a img)")) return;

    clickHandler = function (e) {
      var img = e.target.closest(".app-prose img:not(a img)");
      if (!img) return;
      loadZoom().then(function () {
        if (zoomInstance) zoomInstance.open({ target: img });
      });
    };
    article.addEventListener("click", clickHandler);
  }

  initImageZoom();
  document.addEventListener("astro:page-load", initImageZoom);
  document.addEventListener("astro:before-swap", destroyImageZoom);
</script>

<style is:global>
  .medium-zoom-overlay {
    background-color: color-mix(
      in srgb,
      var(--color-background) 80%,
      transparent
    ) !important;
    z-index: 998;
    transition: opacity 300ms ease !important;
  }

  .medium-zoom-image--opened {
    z-index: 999;
  }

  .app-prose img {
    height: auto;
    max-width: 100%;
  }
</style>
