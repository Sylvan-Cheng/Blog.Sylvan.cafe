<script>
  import type mediumZoom from "medium-zoom";

  let zoomInstance: ReturnType<typeof mediumZoom> | null = null;
  let zoomLoading = false;
  let clickHandler: ((e: MouseEvent) => Promise<void>) | null = null;

  async function loadZoom() {
    if (zoomInstance || zoomLoading) return;
    zoomLoading = true;
    const images = document.querySelectorAll(".app-prose img:not(a img)");
    if (images.length === 0) { zoomLoading = false; return; }

    const { default: mediumZoom } = await import("medium-zoom");
    zoomInstance = mediumZoom(images, { margin: 24 });
    zoomLoading = false;
  }

  function destroyImageZoom() {
    if (zoomInstance) {
      zoomInstance.detach();
      zoomInstance = null;
    }
    zoomLoading = false;
    if (clickHandler) {
      const article = document.getElementById("article");
      if (article) article.removeEventListener("click", clickHandler as unknown as EventListener);
      clickHandler = null;
    }
  }

  document.addEventListener("astro:page-load", () => {
    destroyImageZoom();

    const article = document.getElementById("article");
    if (!article) return;

    // 页面无图片则跳过，不绑定任何监听器
    if (!document.querySelector(".app-prose img:not(a img)")) return;

    clickHandler = async function (e: MouseEvent) {
      const img = (e.target as HTMLElement)?.closest?.(".app-prose img:not(a img)") as HTMLElement | null;
      if (!img) return;
      await loadZoom();
      if (zoomInstance) zoomInstance.open({ target: img });
    };
    article.addEventListener("click", clickHandler as unknown as EventListener);
  });

  document.addEventListener("astro:before-swap", destroyImageZoom);
</script>

<style is:global>
  .medium-zoom-overlay {
    background-color: color-mix(
      in srgb,
      var(--color-background) 80%,
      transparent
    ) !important;
    z-index: 998;
    transition: opacity 300ms ease !important;
  }

  .medium-zoom-image--opened {
    z-index: 999;
  }

  .app-prose img {
    height: auto;
    max-width: 100%;
  }
</style>
