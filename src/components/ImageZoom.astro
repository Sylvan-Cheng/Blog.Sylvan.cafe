---
/*
 * 图片缩放客户端脚本。
 * 构建期由 rehypeImgProxy 插件为 s3 图片注入 img-zoomable class 和 data-zoom-src。
 * 运行时：检测 .img-zoomable → 动态 import medium-zoom → 事件委托点击打开。
 * open 时 src 切到 data-zoom-src 高清原图，close 时切回缩略图。
 *
 * 关键：<script> 不能加 is:inline，否则 Vite 不打包 import("medium-zoom")，
 * 浏览器无法解析裸模块说明符，zoom 静默失败（a893c1a 引入的回归）。
 *
 * mediumZoom 必须传入 images，否则内部 _images 为空，open({target}) 查找失败。副作用是
 * mediumZoom 自身也会绑定 click → 首次加载后点击会双触发 open()，但 medium-zoom 幂等无害。
 */
---

<script>
  import type mediumZoom from "medium-zoom";

  let zoomInstance: ReturnType<typeof mediumZoom> | null = null;
  let zoomLoading = false;
  let clickHandler: ((e: MouseEvent) => void) | null = null;

  function swapSrc(img: HTMLImageElement, toHiRes: boolean) {
    if (toHiRes && img.dataset.zoomSrc) {
      img.dataset.zoomThumb = img.src;
      img.src = img.dataset.zoomSrc;
    } else if (!toHiRes && img.dataset.zoomThumb) {
      img.src = img.dataset.zoomThumb;
    }
  }

  async function loadZoom() {
    if (zoomInstance || zoomLoading) return;
    zoomLoading = true;
    const images = document.querySelectorAll<HTMLImageElement>(".img-zoomable");
    if (images.length === 0) { zoomLoading = false; return; }

    const { default: mediumZoom } = await import("medium-zoom");
    // 必须传入 images。不传则 mediumZoom 内部 _images 为空数组，
    // open({target}) 在 _images 中查找不到目标，静默返回不缩放。
    zoomInstance = mediumZoom(images, { margin: 24 });
    zoomInstance.on("open", e => swapSrc(e.target as HTMLImageElement, true));
    zoomInstance.on("close", e => swapSrc(e.target as HTMLImageElement, false));
    zoomLoading = false;
  }

  function destroyImageZoom() {
    if (zoomInstance) {
      zoomInstance.detach();
      zoomInstance = null;
    }
    zoomLoading = false;
    if (clickHandler) {
      const article = document.getElementById("article");
      if (article) article.removeEventListener("click", clickHandler);
      clickHandler = null;
    }
  }

  document.addEventListener("astro:page-load", () => {
    destroyImageZoom();

    const article = document.getElementById("article");
    if (!article) return;

    if (!document.querySelector(".img-zoomable")) return;

    clickHandler = function (e: MouseEvent) {
      const img = (e.target as HTMLElement)?.closest?.(".img-zoomable") as HTMLImageElement | null;
      if (!img) return;
      loadZoom().then(() => {
        if (zoomInstance) zoomInstance.open({ target: img });
      });
    };
    article.addEventListener("click", clickHandler);
  });

  document.addEventListener("astro:before-swap", destroyImageZoom);
</script>

<style is:global>
  .medium-zoom-overlay {
    background-color: color-mix(
      in srgb,
      var(--color-background) 80%,
      transparent
    ) !important;
    z-index: 998;
    transition: opacity 300ms ease !important;
  }

  .medium-zoom-image--opened {
    z-index: 999;
  }

  .img-zoomable {
    height: auto;
    max-width: 100%;
    cursor: zoom-in;
  }
</style>
