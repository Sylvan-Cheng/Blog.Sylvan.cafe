---
import Icon from "@/components/Icon.astro";
import { SITE } from "@/config";
import { UI } from "@/i18n/ui";
import { resolveLocale, t } from "@/i18n/utils";
import LinkButton from "./LinkButton.astro";

const locale = resolveLocale(Astro.currentLocale);
---

{
  SITE.showBackButton && (
    <div class="app-layout flex items-center justify-start" data-print-hide>
      <LinkButton
        id="back-button"
        href="/"
        class="hover-quiet -ms-2 mt-8 mb-2"
      >
        <Icon name="tabler:chevron-left" class="inline-block size-6 rtl:rotate-180" />
        <span>{t(UI.post.goBack, locale)}</span>
      </LinkButton>
    </div>
  )
}

<script>
  import { initScript, onSwap } from "../scripts/lifecycle";

  const signal = initScript("__backBtnAC");
  const LOCALE_RE = /^\/([a-z]{2})\//;

  function extractLocale(path: string): string {
    return LOCALE_RE.exec(path)?.[1] ?? "";
  }

  function updateGoBackUrl() {
    const backButton: HTMLAnchorElement | null =
      document.querySelector("#back-button");
    if (!backButton) return;

    const prevUrl = sessionStorage.getItem("prevUrl");
    const currentLocale = extractLocale(window.location.pathname);

    if (prevUrl && currentLocale && extractLocale(prevUrl) === currentLocale) {
      backButton.href = prevUrl;
      return;
    }

    const main = document.querySelector("#main-content") as HTMLElement | null;
    const backUrl = main?.dataset?.backurl;
    if (backUrl) backButton.href = backUrl;
  }

  document.addEventListener(
    "astro:before-swap",
    () => {
      if (!document.querySelector("#article")) {
        sessionStorage.setItem(
          "prevUrl",
          window.location.pathname + window.location.search,
        );
      }
    },
    { signal },
  );

  onSwap(updateGoBackUrl, signal);
</script>
