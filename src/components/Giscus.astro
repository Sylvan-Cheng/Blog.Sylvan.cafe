---
import { SITE, THEME_DEFS } from "@/config";
import { resolveLocale } from "@/i18n/utils";

const giscus = SITE.giscus;
const locale = resolveLocale(Astro.currentLocale);
const giscusLang = { zh: "zh-CN", en: "en", ja: "ja", ru: "ru", eo: "eo" }[
  locale
];

const giscusTheme = THEME_DEFS[SITE.themeScheme].giscus;

// Strip locale prefix for cross-language comment sharing
const localePrefix = Astro.currentLocale;
const path = localePrefix
  ? Astro.url.pathname.replace(new RegExp(`^/${localePrefix}/`), "/")
  : Astro.url.pathname;
const giscusTerm = path.replace(/\/$/, "") || "/";
---

{
  giscus.enabled && (
    <div class="mt-8">
      <script
        id="giscus-script"
        src="https://giscus.app/client.js"
        is:inline
        data-repo={giscus.repo}
        data-repo-id={giscus.repoId}
        data-category={giscus.category}
        data-category-id={giscus.categoryId}
        data-mapping={giscus.mapping}
        data-term={giscusTerm}
        data-strict={giscus.strict.toString()}
        data-reactions-enabled={giscus.reactionsEnabled}
        data-emit-metadata={giscus.emitMetadata.toString()}
        data-input-position={giscus.inputPosition}
        data-theme={giscusTheme.dark}
        data-dark-theme={giscusTheme.dark}
        data-light-theme={giscusTheme.light}
        data-lang={giscusLang}
        data-loading="lazy"
        crossorigin="anonymous"
        async
      />
    </div>
  )
}

{giscus.enabled && <script src="../scripts/giscus.ts"></script>}
