---
import type { CollectionEntry } from "astro:content";
import type { Locale } from "@/i18n/config";
import { getPostUrl } from "@/utils/contentIdentity";
import { slugifyStr } from "@/utils/slugify";
import Datetime from "./Datetime.astro";

type Props = {
  variant?: "h2" | "h3";
  locale?: Locale;
} & CollectionEntry<"blog">;

const { variant: Heading = "h2", data, locale } = Astro.props;

const { title, description, ...props } = data;
const post = Astro.props as CollectionEntry<"blog">;
const href = getPostUrl(post, locale);
const tags = data.tags.slice(0, 3);
---

<li class="line-frame group border-t py-5 first:border-t-0">
  <article class="grid gap-3 sm:grid-cols-[9.5rem_minmax(0,1fr)]">
    <div class="text-text-muted">
      <Datetime {...props} class="font-mono text-xs uppercase tracking-wide" />
    </div>
    <div>
      <a
        href={href}
        class:list={[
          "tone-link-strong inline-block",
          "focus-visible:no-underline focus-visible:underline-offset-0",
        ]}
      >
        <Heading
          class="type-card-title hover-title"
          transition:name={`p-${slugifyStr(title)}`}
        >
          {title}
        </Heading>
      </a>
      <p class="type-card-desc mt-2">{description}</p>
      {
        tags.length > 0 && (
          <p class="type-micro mt-3 flex flex-wrap gap-x-3 gap-y-1">
            {tags.map(tag => <span>#{tag}</span>)}
          </p>
        )
      }
    </div>
  </article>
</li>
