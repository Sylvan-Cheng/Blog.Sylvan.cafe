---
/*
 * PhotoSwipe lightbox for article images.
 * Build-time Markdown plugins wrap S3 images in .image-lightbox-link when
 * full-size dimensions are available from the image metadata cache.
 */
---

<script>
  import PhotoSwipeLightbox from "photoswipe/lightbox";
  import "photoswipe/style.css";
  import { initInteraction, onSwap } from "../scripts/lifecycle";

  const { signal, onCleanup } = initInteraction("__imgLightboxAC");

  const TABLER_CLOSE_SVG =
    '<svg aria-hidden="true" class="pswp__icn" viewBox="0 0 24 24" width="24" height="24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 6L6 18M6 6l12 12"/></svg>';
  const TABLER_ARROW_PREV_SVG =
    '<svg aria-hidden="true" class="pswp__icn" viewBox="0 0 24 24" width="24" height="24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m15 6l-6 6l6 6"/></svg>';
  const TABLER_ARROW_NEXT_SVG =
    '<svg aria-hidden="true" class="pswp__icn" viewBox="0 0 24 24" width="24" height="24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m9 6l6 6l-6 6"/></svg>';
  const TABLER_ZOOM_SVG =
    '<svg aria-hidden="true" class="pswp__icn" viewBox="0 0 24 24" width="24" height="24"><g class="pswp-tabler-zoom-in"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10a7 7 0 1 0 14 0a7 7 0 1 0-14 0m4 0h6m-3-3v6m11 8l-6-6"/></g><g class="pswp-tabler-zoom-out"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10a7 7 0 1 0 14 0a7 7 0 1 0-14 0m4 0h6m8 11l-6-6"/></g></svg>';

  let lightbox: PhotoSwipeLightbox | null = null;

  function destroyImageLightbox() {
    if (lightbox) {
      lightbox.destroy();
      lightbox = null;
    }
  }

  function initImageLightbox() {
    destroyImageLightbox();

    const article = document.getElementById("article");
    if (!article?.querySelector(".image-lightbox-link")) return;

    lightbox = new PhotoSwipeLightbox({
      arrowNextSVG: TABLER_ARROW_NEXT_SVG,
      arrowPrevSVG: TABLER_ARROW_PREV_SVG,
      bgOpacity: 0.8,
      closeSVG: TABLER_CLOSE_SVG,
      gallery: "#article",
      children: "a.image-lightbox-link",
      pswpModule: () => import("photoswipe"),
      zoomSVG: TABLER_ZOOM_SVG,
    });
    lightbox.init();
  }

  onCleanup(destroyImageLightbox);
  document.addEventListener("astro:before-swap", destroyImageLightbox, {
    signal,
  });
  onSwap(initImageLightbox, signal);
</script>

<style is:global>
  .image-lightbox-link {
    display: block;
    width: fit-content;
    max-width: 100%;
    margin-inline: auto;
    cursor: zoom-in;
  }

  .image-lightbox-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  .img-lightboxable {
    height: auto;
    max-width: 100%;
  }

  .image-lightbox-link > .img-lightboxable {
    margin-block: 1.5rem;
  }

  :root .pswp {
    --pswp-bg: var(--color-background) !important;
    --pswp-error-text-color: var(--color-foreground);
    --pswp-icon-color: var(--color-foreground);
    --pswp-icon-color-secondary: var(--color-foreground);
    --pswp-icon-stroke-color: transparent;
    --pswp-icon-stroke-width: 0;
    --pswp-placeholder-bg: var(--color-muted);
  }

  :root .pswp__button {
    width: 2.5rem;
    height: 2.5rem;
    margin: 0.5rem 0.375rem;
    border: 1px solid transparent !important;
    border-radius: 0.125rem;
    background: transparent !important;
    box-shadow: none !important;
    color: var(--color-foreground);
    opacity: 1;
    transition: color 200ms cubic-bezier(0.4, 0, 0.2, 1) !important;
  }

  :root .pswp__button:hover,
  :root .pswp__button:active,
  :root .pswp__button:focus {
    border: 1px solid transparent !important;
    background: transparent !important;
    box-shadow: none !important;
    color: var(--accent);
    opacity: 1;
    transition: color 200ms cubic-bezier(0.4, 0, 0.2, 1) !important;
  }

  :root .pswp__button:focus-visible {
    outline: 2px dashed var(--accent);
    outline-offset: 2px;
  }

  :root .pswp__button:disabled {
    color: var(--text-muted);
    opacity: 0.45;
  }

  :root .pswp__button .pswp__icn {
    top: 50%;
    left: 50%;
    width: 1.5rem;
    height: 1.5rem;
    margin: 0;
    background: transparent !important;
    box-shadow: none !important;
    fill: currentcolor;
    color: currentcolor;
    stroke: currentcolor;
    transform: translate(-50%, -50%);
  }

  :root .pswp__icn-shadow {
    display: none;
  }

  :root .pswp-tabler-zoom-out,
  :root .pswp--zoomed-in .pswp-tabler-zoom-in {
    display: none;
  }

  :root .pswp--zoomed-in .pswp-tabler-zoom-out {
    display: block;
  }

  :root .pswp__button--close {
    margin-right: 0.5rem;
  }

  :root .pswp__button--arrow {
    top: 50%;
    width: 2.75rem;
    height: 2.75rem;
    margin-top: -1.375rem;
  }

  :root .pswp__button--arrow .pswp__icn {
    left: 50%;
    right: auto;
    width: 1.75rem;
    height: 1.75rem;
    margin: 0;
    transform: translate(-50%, -50%);
  }

  :root .pswp__button--arrow--prev {
    left: 1rem;
  }

  :root .pswp__button--arrow--next {
    right: 1rem;
  }
</style>
