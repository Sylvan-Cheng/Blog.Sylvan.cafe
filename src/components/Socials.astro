---
import { SOCIALS } from "@/constants";
import LinkButton from "./LinkButton.astro";
import Icon from "./Icon.astro";
import Tooltip from "./Tooltip.astro";
import { SITE } from "@/config";
import { UI } from "@/i18n/ui";
import { resolveLocale } from "@/i18n/utils";

const locale = resolveLocale(Astro.currentLocale);

const socialLabelMap: Record<string, string> = {
  GitHub: UI.social.github[locale](SITE.title),
  Mail: UI.social.email[locale](SITE.title),
};
---

<div class="flex flex-wrap items-center gap-1">
  {
    SOCIALS.map(social => (
      <Tooltip text={socialLabelMap[social.name] || social.linkTitle}>
        <LinkButton
          href={social.href}
          class="p-2 hover:rotate-6 sm:p-1"
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon name={social.icon} class="inline-block size-6 scale-125 stroke-current opacity-90 group-hover:fill-transparent sm:scale-110" />
          <span class="sr-only">{socialLabelMap[social.name] || social.linkTitle}</span>
        </LinkButton>
      </Tooltip>
    ))
  }
</div>
