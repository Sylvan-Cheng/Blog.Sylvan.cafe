---
import { SITE } from "@/config";
import { SOCIALS } from "@/constants";
import type { Locale } from "@/i18n/config";
import { UI } from "@/i18n/ui";
import { resolveLocale, tp } from "@/i18n/utils";
import Icon from "./Icon.astro";
import LinkButton from "./LinkButton.astro";
import Tooltip from "./Tooltip.astro";

type Props = {
  locale?: Locale;
};

const { locale: localeOverride } = Astro.props;
const locale = localeOverride ?? resolveLocale(Astro.currentLocale);

const socialLabelMap: Record<string, string> = {
  GitHub: tp(UI.social.github, locale, SITE.author),
  Mail: tp(UI.social.email, locale, SITE.title),
};
---

<div class="flex flex-wrap items-center gap-1">
  {
    SOCIALS.map(social => (
      <Tooltip text={socialLabelMap[social.name] || social.linkTitle}>
        <LinkButton
          href={social.href}
          class="hover-accent p-2 sm:p-1"
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon name={social.icon} class="inline-block size-6 scale-125 stroke-current opacity-90 group-hover:fill-transparent sm:scale-110" />
          <span class="sr-only">{socialLabelMap[social.name] || social.linkTitle}</span>
        </LinkButton>
      </Tooltip>
    ))
  }
</div>
