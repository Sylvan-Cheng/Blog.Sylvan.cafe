---
import Icon from "@/components/Icon.astro";
import LinkButton from "./LinkButton.astro";
import LanguagePicker from "./LanguagePicker.astro";
import { SITE } from "@/config";

const locale = Astro.currentLocale ?? "zh";
const { pathname } = Astro.url;

const localizePath = (path: string) => `/${locale}${path}`;

const i18n = {
  skipToContent: locale === "zh" ? "跳转到内容" : locale === "ja" ? "コンテンツへスキップ" : locale === "ru" ? "Перейти к содержимому" : "Skip to content",
  posts: locale === "zh" ? "文章" : locale === "ja" ? "記事" : locale === "ru" ? "Записи" : "Posts",
  tags: locale === "zh" ? "标签" : locale === "ja" ? "タグ" : locale === "ru" ? "Теги" : "Tags",
  about: locale === "zh" ? "关于" : locale === "ja" ? "概要" : locale === "ru" ? "О сайте" : "About",
  archives: locale === "zh" ? "归档" : locale === "ja" ? "アーカイブ" : locale === "ru" ? "Архив" : "Archives",
  search: locale === "zh" ? "搜索" : locale === "ja" ? "検索" : locale === "ru" ? "Поиск" : "Search",
};

// Remove trailing slash from current pathname if exists
const currentPath =
  pathname.endsWith("/") && pathname !== "/" ? pathname.slice(0, -1) : pathname;

const isActive = (path: string) => {
  // Skip locale prefix when comparing
  const currentParts = currentPath.split("/").filter(p => p.trim());
  const pathParts = path.split("/").filter(p => p.trim());
  // Compare from second segment onward (skip locale)
  return currentParts.slice(1).join("/") === pathParts.slice(1).join("/")
    || currentParts[1] === pathParts[1];
};
---

<a
  id="skip-to-content"
  href="#main-content"
  class="absolute start-16 -top-full z-50 bg-background px-3 py-2 text-accent backdrop-blur-lg transition-all focus:top-4"
>
  {i18n.skipToContent}
</a>

<header
  class="app-layout flex flex-col items-center justify-between sm:flex-row"
>
  <div
    id="top-nav-wrap"
    class:list={[
      "py-4 sm:py-6",
      "border-b border-border",
      "relative w-full bg-background",
      "flex items-center justify-between",
    ]}
  >
    <a
      href={localizePath("/")}
      class="py-1 text-xl leading-8 font-semibold whitespace-nowrap sm:text-2xl sm:leading-none"
    >
      {SITE.title}
    </a>

    <!-- Always-visible icon bar (mobile + desktop) -->
    <div class="flex items-center gap-x-1 sm:gap-x-2 sm:order-2">
      <LinkButton
        href={localizePath("/search")}
        class:list={[
          "focus-outline flex p-3 sm:p-1",
          { "[&>svg]:stroke-accent": isActive(localizePath("/search")) },
        ]}
        title={i18n.search}
        aria-label="search"
      >
        <Icon name="tabler:search" />
        <span class="sr-only">{i18n.search}</span>
      </LinkButton>
      <LanguagePicker />
      {
        SITE.lightAndDarkMode && (
          <button
            id="theme-btn"
            class="focus-outline relative size-12 p-4 sm:size-8 hover:[&>svg]:stroke-accent"
            title="Toggles light & dark"
            aria-label="auto"
            aria-live="polite"
          >
            <Icon name="tabler:moon" class="absolute top-[50%] left-[50%] -translate-[50%] scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
            <Icon name="tabler:sun-high" class="absolute top-[50%] left-[50%] -translate-[50%] scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
          </button>
        )
      }
      <button
        id="menu-btn"
        class="focus-outline p-2 sm:hidden"
        aria-label="Open Menu"
        aria-expanded="false"
        aria-controls="menu-items"
      >
        <Icon name="tabler:x" id="close-icon" class="hidden" />
        <Icon name="tabler:menu-deep" id="menu-icon" />
      </button>
    </div>

    <!-- Navigation links (collapsible on mobile) -->
    <nav
      id="nav-menu"
      class="hidden absolute top-full left-0 w-full bg-background border-t border-border py-2 sm:static sm:flex sm:w-auto sm:border-0 sm:py-0 sm:order-1"
    >
      <ul
        id="menu-items"
        class:list={[
          "flex flex-col items-center gap-2",
          "[&>li>a]:block [&>li>a]:px-4 [&>li>a]:py-2 [&>li>a]:text-center [&>li>a]:font-medium [&>li>a]:hover:text-accent",
          "sm:flex-row sm:gap-x-5 sm:gap-y-0 sm:[&>li>a]:px-2 sm:[&>li>a]:py-1",
        ]}
      >
        <li>
          <a href={localizePath("/posts")} class:list={{ "active-nav": isActive(localizePath("/posts")) }}>
            {i18n.posts}
          </a>
        </li>
        <li>
          <a href={localizePath("/tags")} class:list={{ "active-nav": isActive(localizePath("/tags")) }}>
            {i18n.tags}
          </a>
        </li>
        <li>
          <a href={localizePath("/about")} class:list={{ "active-nav": isActive(localizePath("/about")) }}>
            {i18n.about}
          </a>
        </li>
        {
          SITE.showArchives && (
            <li>
              <a
                href={localizePath("/archives")}
                class:list={{ "active-nav": isActive(localizePath("/archives")) }}
              >
                {i18n.archives}
              </a>
            </li>
          )
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  function toggleNav() {
    const menuBtn = document.querySelector("#menu-btn");
    const navMenu = document.querySelector("#nav-menu");
    const menuIcon = document.querySelector("#menu-icon");
    const closeIcon = document.querySelector("#close-icon");

    if (!menuBtn || !navMenu || !menuIcon || !closeIcon) return;

    menuBtn.addEventListener("click", () => {
      const openMenu = menuBtn.getAttribute("aria-expanded") === "true";

      menuBtn.setAttribute("aria-expanded", openMenu ? "false" : "true");
      menuBtn.setAttribute("aria-label", openMenu ? "Open Menu" : "Close Menu");

      navMenu.classList.toggle("hidden");
      menuIcon.classList.toggle("hidden");
      closeIcon.classList.toggle("hidden");
    });
  }

  toggleNav();

  // Runs on view transitions navigation
  document.addEventListener("astro:after-swap", toggleNav);
</script>
