---
import Icon from "@/components/Icon.astro";
import { SITE } from "@/config";
import { SOCIALS } from "@/constants";
import { UI } from "@/i18n/ui";
import { resolveLocale, t, tp } from "@/i18n/utils";
import LanguagePicker from "./LanguagePicker.astro";
import LinkButton from "./LinkButton.astro";
import Tooltip from "./Tooltip.astro";

const locale = resolveLocale(Astro.currentLocale);
const { pathname } = Astro.url;

const localizePath = (path: string) => `/${locale}${path === "/" ? "" : path}/`;

const currentPath =
  pathname.endsWith("/") && pathname !== "/" ? pathname.slice(0, -1) : pathname;

const isActive = (path: string) => {
  const currentParts = currentPath.split("/").filter((p) => p.trim());
  const pathParts = path.split("/").filter((p) => p.trim());
  return (
    currentParts.slice(1).join("/") === pathParts.slice(1).join("/") ||
    currentParts[1] === pathParts[1]
  );
};

const navItems = [
  { href: localizePath("/posts"), label: t(UI.nav.posts, locale) },
  { href: localizePath("/tags"), label: t(UI.nav.tags, locale) },
  { href: localizePath("/series"), label: t(UI.nav.series, locale) },
  ...(SITE.showArchives
    ? [{ href: localizePath("/archives"), label: t(UI.nav.archives, locale) }]
    : []),
  { href: localizePath("/about"), label: t(UI.nav.about, locale) },
];

const socialLabelMap: Record<string, string> = {
  GitHub: tp(UI.social.github, locale, SITE.author),
  Mail: tp(UI.social.email, locale, SITE.title),
};

const sidebarLinks = [
  {
    href: `/${locale}/rss.xml`,
    icon: "tabler:rss",
    label: t(UI.rssFeed, locale),
    external: false,
  },
  ...SOCIALS.map((social) => ({
    href: social.href,
    icon: social.icon,
    label: socialLabelMap[social.name] || social.linkTitle,
    external: true,
  })),
];
---

<a
  id="skip-to-content"
  href="#main-content"
  data-print-hide
  class="absolute start-16 z-50 bg-background px-3 py-2 text-accent backdrop-blur-lg transition-[top,translate] duration-200"
>
  {t(UI.nav.skipToContent, locale)}
</a>

<style is:inline>
  #skip-to-content {
    top: 0;
    translate: 0 -100%;
  }

  #skip-to-content:focus {
    top: 1rem;
    translate: 0;
  }
</style>

<header class="site-header" data-print-hide>
  <div id="top-nav-wrap" class="top-bar">
    <a
      href={localizePath("/")}
      class="hover-accent py-1 text-accent text-xl leading-8 font-semibold whitespace-nowrap"
    >
      {SITE.title}
    </a>

    <div class="flex items-center gap-x-1 sm:gap-x-2">
      <Tooltip text={t(UI.nav.search, locale)}>
        <LinkButton
          href={localizePath("/search")}
          class="flex p-3 sm:p-1"
          aria-label={t(UI.nav.search, locale)}
        >
          <Icon name="tabler:search" />
          <span class="sr-only">{t(UI.nav.search, locale)}</span>
        </LinkButton>
      </Tooltip>
      <LanguagePicker />
      {
        SITE.lightAndDarkMode && (
          <Tooltip text={t(UI.themeToggle, locale)}>
            <button
              id="theme-btn"
              class="relative size-12 p-4 sm:size-8"
              aria-label={t(UI.themeToggle, locale)}
              aria-live="polite"
            >
              <Icon
                name="tabler:moon"
                class="absolute top-[50%] left-[50%] -translate-[50%] scale-100 rotate-0 transition-transform duration-200 dark:scale-0 dark:-rotate-90"
              />
              <Icon
                name="tabler:sun-high"
                class="absolute top-[50%] left-[50%] -translate-[50%] scale-0 rotate-90 transition-transform duration-200 dark:scale-100 dark:rotate-0"
              />
            </button>
          </Tooltip>
        )
      }
      <Tooltip text={t(UI.openMenu, locale)}>
        <button
          id="menu-btn"
          class="hover-accent p-2 xl:hidden"
          aria-label={t(UI.openMenu, locale)}
          data-open-label={t(UI.openMenu, locale)}
          data-close-label={t(UI.closeMenu, locale)}
          aria-expanded="false"
          aria-controls="nav-menu"
        >
          <Icon name="tabler:x" id="close-icon" class="hidden" />
          <Icon name="tabler:menu-deep" id="menu-icon" />
        </button>
      </Tooltip>
    </div>

  </div>

  <nav id="nav-menu" class="mobile-nav-menu hidden xl:hidden" aria-label={t(UI.nav.primary, locale)}>
    <ul class="flex flex-col items-center gap-1">
      {navItems.map(({ href, label }) => (
        <li class="w-full">
          <a
            href={href}
            class="hover-accent block px-4 py-3 text-center font-medium"
            class:list={{ "active-nav": isActive(href) }}
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<aside class="site-pane" data-print-hide>
  <div class="flex min-h-full flex-col">
    <section class="site-signature hidden xl:block" aria-label={SITE.title}>
      <p class="site-kicker">{t(UI.siteNote, locale)}</p>
      <p class="mt-3 text-text-muted text-base leading-relaxed">
        {t(UI.home.desc, locale)}
      </p>
    </section>

    <nav class="desktop-nav-menu hidden xl:block" aria-label={t(UI.nav.primary, locale)}>
      <ul class="flex flex-col items-center gap-1 xl:items-stretch">
        {navItems.map(({ href, label }) => (
          <li class="w-full sm:w-auto">
            <a
              href={href}
              class="hover-accent block px-4 py-3 text-center font-medium sm:px-2 sm:py-1 xl:text-start"
              class:list={{ "active-nav": isActive(href) }}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <nav class="site-social-links" aria-label={t(UI.nav.social, locale)}>
      <ul class="mx-auto flex items-center justify-center">
        {sidebarLinks.map(({ href, icon, label, external }) => (
          <li>
            <Tooltip text={label}>
              <LinkButton
                href={href}
                class="shape-control"
                target={external ? "_blank" : undefined}
                rel={external ? "noopener noreferrer" : undefined}
              >
                <Icon name={icon} class="inline-block size-5.5" />
                <span class="sr-only">{label}</span>
              </LinkButton>
            </Tooltip>
          </li>
        ))}
      </ul>
    </nav>
  </div>

</aside>

<script src="../scripts/nav.ts"></script>
