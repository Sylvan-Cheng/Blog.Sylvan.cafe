---
import Icon from "@/components/Icon.astro";
import LinkButton from "./LinkButton.astro";
import LanguagePicker from "./LanguagePicker.astro";
import { SITE } from "@/config";
import { UI } from "@/i18n/ui";
import { resolveLocale, t } from "@/i18n/utils";

const locale = resolveLocale(Astro.currentLocale);
const { pathname } = Astro.url;

const localizePath = (path: string) => `/${locale}${path}`;

const openLabel = t(UI.openMenu, locale);
const closeLabel = t(UI.closeMenu, locale);

const currentPath =
  pathname.endsWith("/") && pathname !== "/" ? pathname.slice(0, -1) : pathname;

const isActive = (path: string) => {
  const currentParts = currentPath.split("/").filter(p => p.trim());
  const pathParts = path.split("/").filter(p => p.trim());
  return currentParts.slice(1).join("/") === pathParts.slice(1).join("/")
    || currentParts[1] === pathParts[1];
};
---

<a
  id="skip-to-content"
  href="#main-content"
  class="absolute start-16 -top-full z-50 bg-background px-3 py-2 text-accent backdrop-blur-lg transition-all focus:top-4"
>
  {t(UI.nav.skipToContent, locale)}
</a>

<header class="app-layout">
  <div
    id="top-nav-wrap"
    class="relative flex items-center justify-between border-b border-border py-4 sm:py-6"
  >
    <a
      href={localizePath("/")}
      class="py-1 text-xl leading-8 font-semibold whitespace-nowrap sm:text-2xl sm:leading-none"
    >
      {SITE.title}
    </a>

    <div class="flex items-center gap-x-1 sm:gap-x-2 sm:order-3">
      <LinkButton
        href={localizePath("/search")}
        class="focus-outline flex p-3 sm:p-1"
          title={t(UI.nav.search, locale)}
        aria-label="search"
      >
        <Icon name="tabler:search" />
        <span class="sr-only">{t(UI.nav.search, locale)}</span>
      </LinkButton>
      <LanguagePicker />
      {
        SITE.lightAndDarkMode && (
          <button
            id="theme-btn"
            class="focus-outline relative size-12 p-4 sm:size-8"
            title={t(UI.themeToggle, locale)}
            aria-label="auto"
            aria-live="polite"
          >
            <Icon name="tabler:moon" class="absolute top-[50%] left-[50%] -translate-[50%] scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
            <Icon name="tabler:sun-high" class="absolute top-[50%] left-[50%] -translate-[50%] scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
          </button>
        )
      }
      <button
        id="menu-btn"
        class="focus-outline p-2 sm:hidden"
        aria-label={t(UI.openMenu, locale)}
        data-open-label={t(UI.openMenu, locale)}
        data-close-label={t(UI.closeMenu, locale)}
        aria-expanded="false"
        aria-controls="nav-menu"
      >
        <Icon name="tabler:x" id="close-icon" class="hidden" />
        <Icon name="tabler:menu-deep" id="menu-icon" />
      </button>
    </div>

    <nav
      id="nav-menu"
      class="hidden absolute top-full left-0 w-full z-40 border-b border-border bg-background py-4 shadow-lg sm:static sm:order-2 sm:flex sm:w-auto sm:border-0 sm:bg-transparent sm:py-0 sm:shadow-none"
    >
      <ul class="flex flex-col items-center gap-1 sm:flex-row sm:gap-x-5">
        <li class="w-full sm:w-auto">
          <a href={localizePath("/posts")} class="block px-4 py-3 text-center font-medium hover:text-accent sm:px-2 sm:py-1" class:list={{ "active-nav": isActive(localizePath("/posts")) }}>
            {t(UI.nav.posts, locale)}
          </a>
        </li>
        <li class="w-full sm:w-auto">
          <a href={localizePath("/tags")} class="block px-4 py-3 text-center font-medium hover:text-accent sm:px-2 sm:py-1" class:list={{ "active-nav": isActive(localizePath("/tags")) }}>
            {t(UI.nav.tags, locale)}
          </a>
        </li>
        <li class="w-full sm:w-auto">
          <a href={localizePath("/about")} class="block px-4 py-3 text-center font-medium hover:text-accent sm:px-2 sm:py-1" class:list={{ "active-nav": isActive(localizePath("/about")) }}>
            {t(UI.nav.about, locale)}
          </a>
        </li>
        {
          SITE.showArchives && (
            <li class="w-full sm:w-auto">
              <a href={localizePath("/archives")} class="block px-4 py-3 text-center font-medium hover:text-accent sm:px-2 sm:py-1" class:list={{ "active-nav": isActive(localizePath("/archives")) }}>
                {t(UI.nav.archives, locale)}
              </a>
            </li>
          )
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  function toggleNav() {
    const menuBtn = document.querySelector("#menu-btn");
    const navMenu = document.querySelector("#nav-menu");
    const menuIcon = document.querySelector("#menu-icon");
    const closeIcon = document.querySelector("#close-icon");

    if (!menuBtn || !navMenu || !menuIcon || !closeIcon) return;

    const openLabel = menuBtn.getAttribute("data-open-label") || "Open Menu";
    const closeLabel = menuBtn.getAttribute("data-close-label") || "Close Menu";

    menuBtn.addEventListener("click", () => {
      const openMenu = menuBtn.getAttribute("aria-expanded") === "true";
      menuBtn.setAttribute("aria-expanded", openMenu ? "false" : "true");
      menuBtn.setAttribute("aria-label", openMenu ? openLabel : closeLabel);
      navMenu.classList.toggle("hidden");
      menuIcon.classList.toggle("hidden");
      closeIcon.classList.toggle("hidden");
    });
  }

  toggleNav();
  document.addEventListener("astro:after-swap", toggleNav);
</script>
