---
import { UI } from "@/i18n/ui";
import { resolveLocale, t } from "@/i18n/utils";

const locale = resolveLocale(Astro.currentLocale);
const labelExpand = t(UI.codeBlock.expand, locale);
const labelCollapse = t(UI.codeBlock.collapse, locale);
---

<style is:global>
  /* Shiki 内联设置了 position: relative + overflow-x: auto，此处不重复添加以避免滚动条与按钮错位 */
  pre[data-collapse] {
    --cf-max-h: 12rem;
    --cf-duration: 400ms;
    --cf-easing: cubic-bezier(0.4, 0, 0.2, 1);
  }

  pre[data-collapse] > code {
    max-height: var(--cf-max-h);
    overflow: hidden;
    -webkit-mask-image: linear-gradient(
      to bottom,
      black calc(100% - 3rem),
      transparent
    );
    mask-image: linear-gradient(
      to bottom,
      black calc(100% - 3rem),
      transparent
    );
    transition: max-height var(--cf-duration) var(--cf-easing);
  }

  /* 折叠按钮 — 底部居中 */
  .cf-btn {
    position: absolute;
    z-index: 10;
    left: 0;
    right: 0;
    margin-left: auto;
    margin-right: auto;
    width: fit-content;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    padding: 4px 8px;
    border: 1px solid var(--color-border);
    border-radius: 0.25rem;
    background: var(--color-muted);
    color: var(--color-foreground);
    font-size: 0.75rem;
    line-height: 1rem;
    font-weight: 500;
    font-family: var(--font-body);
    cursor: pointer;
    transition: background-color 150ms ease-out;
  }

  .cf-btn svg {
    width: 1em;
    height: 1em;
    flex-shrink: 0;
  }

  .cf-btn:hover,
  .cf-btn:focus-visible {
    background: var(--color-border);
  }
</style>

<script is:inline define:vars={{ labelExpand, labelCollapse }}>
  function initCodeFolding() {
    const chevronDownD = 'm6 9 6 6 6-6';
    const chevronUpD = 'm18 15-6-6-6 6';

    function createChevronSVG(d) {
      const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
      svg.setAttribute('aria-hidden', 'true');
      svg.setAttribute('viewBox', '0 0 24 24');
      svg.setAttribute('fill', 'none');
      svg.setAttribute('stroke', 'currentColor');
      svg.setAttribute('stroke-width', '2');
      svg.setAttribute('stroke-linecap', 'round');
      svg.setAttribute('stroke-linejoin', 'round');
      const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      path.setAttribute('d', d);
      svg.appendChild(path);
      return svg;
    }

    const pres = document.querySelectorAll("pre[data-collapse]");
    if (pres.length === 0) return;

    const rootFS = parseFloat(
      getComputedStyle(document.documentElement).fontSize,
    );

    pres.forEach(function (pre) {
      if (pre.querySelector(".cf-btn")) return;

      const code = pre.querySelector("code");
      if (!code) return;

      // 测量自然高度：先写隐藏样式，下一帧读取避免强制同步重排
      const maxHPx =
        parseFloat(getComputedStyle(pre).getPropertyValue("--cf-max-h")) *
        rootFS;
      code.style.visibility = "hidden";
      code.style.transition = "none";
      code.style.maxHeight = "none";
      code.style.maskImage = "none";
      code.style.setProperty("-webkit-mask-image", "none");
      requestAnimationFrame(function () {
        const fullH = code.scrollHeight;
        code.style.visibility = "";
        code.style.transition = "";
        code.style.maxHeight = "";
        code.style.maskImage = "";
        code.style.setProperty("-webkit-mask-image", "");

        if (fullH <= maxHPx) {
          // 内容不足，永久展开
          code.style.maxHeight = "none";
          code.style.overflow = "";
          code.style.maskImage = "none";
          code.style.setProperty("-webkit-mask-image", "none");
          return;
        }

        // 内容超标，保持折叠 + 创建按钮
        const btn = document.createElement("button");
        btn.className = "cf-btn";
        btn.type = "button";
        const leftSvg = createChevronSVG(chevronDownD);
        const textSpan = document.createElement("span");
        textSpan.className = "cf-btn-text";
        textSpan.textContent = labelExpand;
        const rightSvg = createChevronSVG(chevronDownD);
        btn.appendChild(leftSvg);
        btn.appendChild(textSpan);
        btn.appendChild(rightSvg);
        btn._leftPath = leftSvg.firstChild;
        btn._textSpan = textSpan;
        btn._rightPath = rightSvg.firstChild;
        btn.setAttribute("aria-expanded", "false");
        btn.setAttribute("aria-label", labelExpand);
        btn.style.bottom = "-0.75rem";
        pre.appendChild(btn);
        pre.classList.add("cf-collapsed");

        let animating = false;

        btn.addEventListener("click", function () {
          if (animating) return;
          animating = true;

          const isCollapsed = pre.classList.contains("cf-collapsed");

          if (isCollapsed) {
            code.style.overflow = "hidden";
            code.style.maxHeight = fullH + "px";
            code.style.maskImage = "none";
            code.style.setProperty("-webkit-mask-image", "none");
            pre.classList.remove("cf-collapsed");
            btn._leftPath.setAttribute('d', chevronUpD);
            btn._rightPath.setAttribute('d', chevronUpD);
            btn._textSpan.textContent = labelCollapse;
            btn.setAttribute("aria-expanded", "true");
            btn.setAttribute("aria-label", labelCollapse);
          } else {
            code.style.overflow = "hidden";
            code.style.maxHeight = code.scrollHeight + "px";
            requestAnimationFrame(function () {
              code.style.maxHeight = "var(--cf-max-h)";
              code.style.maskImage = "";
              code.style.setProperty("-webkit-mask-image", "");
              pre.classList.add("cf-collapsed");
              btn._leftPath.setAttribute('d', chevronDownD);
              btn._rightPath.setAttribute('d', chevronDownD);
              btn._textSpan.textContent = labelExpand;
              btn.setAttribute("aria-expanded", "false");
              btn.setAttribute("aria-label", labelExpand);
            });
          }

          const computedDuration = parseFloat(
            getComputedStyle(code).getPropertyValue("--cf-duration"),
          ) || 400;
          const safetyTimer = setTimeout(function () {
            if (!animating) return;
            if (pre.classList.contains("cf-collapsed")) {
              code.style.maxHeight = "";
              code.style.overflow = "";
              code.style.maskImage = "";
              code.style.setProperty("-webkit-mask-image", "");
            } else {
              code.style.maxHeight = "none";
              code.style.overflow = "";
              code.style.maskImage = "none";
              code.style.setProperty("-webkit-mask-image", "none");
            }
            animating = false;
          }, computedDuration + 300);

          code.addEventListener(
            "transitionend",
            function (e) {
              if (e.propertyName !== "max-height") return;
              clearTimeout(safetyTimer);
              if (pre.classList.contains("cf-collapsed")) {
                code.style.maxHeight = "";
                code.style.overflow = "";
                code.style.maskImage = "";
                code.style.setProperty("-webkit-mask-image", "");
              } else {
                code.style.maxHeight = "none";
                code.style.overflow = "";
                code.style.maskImage = "none";
                code.style.setProperty("-webkit-mask-image", "none");
              }
              animating = false;
            },
            { once: true },
          );
        });
      });
    });
  }

  document.addEventListener("astro:page-load", initCodeFolding);
</script>
