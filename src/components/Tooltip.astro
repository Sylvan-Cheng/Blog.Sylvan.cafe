---
interface Props {
  text: string;
  class?: string;
}

const { text, class: className = "" } = Astro.props;
---

<span class:list={["tooltip-wrap group relative inline-block", className]}>
  <slot />
  <span
    role="tooltip"
    data-tooltip-text
    class="tooltip-popover"
    style="top:0;left:0;"
  >
    {text}
  </span>
</span>
