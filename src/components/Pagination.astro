---
import type { CollectionEntry } from "astro:content";
import type { Page } from "astro";
import Icon from "@/components/Icon.astro";
import { UI } from "@/i18n/ui";
import { resolveLocale, t } from "@/i18n/utils";
import LinkButton from "./LinkButton.astro";

type Props = {
  page: Page<CollectionEntry<"blog">>;
};

const { page } = Astro.props;
const locale = resolveLocale(Astro.currentLocale);
---

{
  page.lastPage > 1 && (
    <nav
      class="mt-auto mb-8 flex justify-center"
      role="navigation"
      aria-label="Pagination Navigation"
    >
      <LinkButton
        disabled={!page.url.prev}
        href={page.url.prev as string}
        class:list={["me-4 select-none", { "opacity-50": !page.url.prev }]}
        aria-label="Goto Previous Page"
      >
        <Icon name="tabler:arrow-left" class="inline-block rtl:rotate-180" />
        {t(UI.pagination.prev, locale)}
      </LinkButton>
      {page.currentPage} / {page.lastPage}
      <LinkButton
        disabled={!page.url.next}
        href={page.url.next as string}
        class:list={["ms-4 select-none", { "opacity-50": !page.url.next }]}
        aria-label="Goto Next Page"
      >
        {t(UI.pagination.next, locale)}
        <Icon name="tabler:arrow-right" class="inline-block rtl:rotate-180" />
      </LinkButton>
    </nav>
  )
}
