---
import type { Page } from "astro";
import type { CollectionEntry } from "astro:content";
import Icon from "@/components/Icon.astro";
import LinkButton from "./LinkButton.astro";

type Props = {
  page: Page<CollectionEntry<"blog">>;
};

const { page } = Astro.props;
const locale = Astro.currentLocale ?? "zh";
const i18nPrev = locale === "zh" ? "上一页" : locale === "ja" ? "前へ" : locale === "ru" ? "Назад" : "Prev";
const i18nNext = locale === "zh" ? "下一页" : locale === "ja" ? "次へ" : locale === "ru" ? "Вперёд" : "Next";
---

{
  page.lastPage > 1 && (
    <nav
      class="mt-auto mb-8 flex justify-center"
      role="navigation"
      aria-label="Pagination Navigation"
    >
      <LinkButton
        disabled={!page.url.prev}
        href={page.url.prev as string}
        class:list={["me-4 select-none", { "opacity-50": !page.url.prev }]}
        aria-label="Goto Previous Page"
      >
        <Icon name="tabler:arrow-left" class="inline-block rtl:rotate-180" />
        {i18nPrev}
      </LinkButton>
      {page.currentPage} / {page.lastPage}
      <LinkButton
        disabled={!page.url.next}
        href={page.url.next as string}
        class:list={["ms-4 select-none", { "opacity-50": !page.url.next }]}
        aria-label="Goto Next Page"
      >
        {i18nNext}
        <Icon name="tabler:arrow-right" class="inline-block rtl:rotate-180" />
      </LinkButton>
    </nav>
  )
}
