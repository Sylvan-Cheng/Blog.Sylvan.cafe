---
import Icon from "@/components/Icon.astro";
import { translateTag } from "@/i18n/tags";
import { resolveLocale } from "@/i18n/utils";

type Props = {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
};

const { tag, tagName, size = "lg" } = Astro.props;
const locale = resolveLocale(Astro.currentLocale);
const display = translateTag(tag, "en", locale) ?? tagName;
---

<li>
  <a
    href={`/${locale}/tags/${tag}/`}
    transition:name={`p-${tag}`}
    class:list={[
      "flex items-center gap-0.5",
      "border-b-2 border-dashed border-foreground",
      "hover:-translate-y-0.5 hover:border-accent hover:text-accent",
      "focus-visible:border-none focus-visible:text-accent",
      { "text-sm": size === "sm" },
      { "text-lg": size === "lg" },
    ]}
  >
    <Icon name="tabler:hash"
      class:list={[
        "opacity-80",
        { "size-5": size === "lg" },
        { "size-4": size === "sm" },
      ]}
    />
    {display}
  </a>
</li>
