---
import { UI } from "@/i18n/ui";
import { resolveLocale, t } from "@/i18n/utils";
import {
  getShareHref,
  getShareLabel,
  getSharePlatforms,
} from "@/utils/shareConfig";
import Icon from "./Icon.astro";
import LinkButton from "./LinkButton.astro";
import Tooltip from "./Tooltip.astro";

const locale = resolveLocale(Astro.currentLocale);
const pageUrl = Astro.url.href;
const cfg = getSharePlatforms(locale);

const LINK =
  "scale-90 p-2 hover:-translate-y-[0.05rem] transition-transform duration-200 sm:p-1 " +
  "focus-ring";

const ICON =
  "inline-block size-6 scale-125 stroke-current " +
  "opacity-90 group-hover:fill-transparent sm:scale-110";
---

<div class="flex flex-none flex-col items-center justify-center gap-1 md:items-start" data-print-hide>
  <span class="italic">{t(UI.share.heading, locale)}</span>
  <div class="flex flex-wrap items-center justify-center gap-1 md:justify-start" data-share-container>
    <!-- narrow-screen centering spacer -->
    <div class="max-md:inline-block hidden relative" aria-hidden="true">
      <span class="inline-flex items-center gap-1 scale-90 p-2 sm:p-1 invisible pointer-events-none">
        <Icon name="tabler:plus" class={ICON} />
      </span>
    </div>

    <!-- primary buttons -->
    {cfg.primary.map(icon => (
      <Tooltip text={getShareLabel(icon, locale)}>
        {icon === 'copy' ? (
          <LinkButton href="#" class={LINK} data-share-btn="copy" aria-label={getShareLabel('copy', locale)}>
            <span class="share-copy-default"><Icon name="tabler:copy" class={ICON} /></span>
            <span class="share-copy-success hidden"><Icon name="tabler:check" class={ICON} /></span>
            <span class="sr-only" aria-live="polite" data-share-live
                  data-live-success={t(UI.share.copySuccess, locale)}
                  data-live-error={t(UI.share.copyError, locale)}
                  data-live-unsupported={t(UI.share.copyUnsupported, locale)}></span>
          </LinkButton>
        ) : (
          <LinkButton
            href={getShareHref(icon, pageUrl)}
            target={getShareHref(icon, pageUrl) !== '#' ? '_blank' : undefined}
            rel={getShareHref(icon, pageUrl) !== '#' ? 'noopener noreferrer' : undefined}
            class={LINK}
            data-share-btn={icon}
            aria-label={getShareLabel(icon, locale)}
          >
            <Icon name={`tabler:${icon}`} class={ICON} />
          </LinkButton>
        )}
      </Tooltip>
    ))}

    <!-- more items (hidden until expanded) -->
    <span
      data-share-more
      class="inline-flex items-center gap-1 max-md:order-2 max-md:w-full max-md:justify-center max-md:flex-wrap"
      style="max-width:0;max-height:0"
    >
      {cfg.more.map(icon => (
        <Tooltip text={getShareLabel(icon, locale)}>
          <LinkButton
            href={getShareHref(icon, pageUrl)}
            target={getShareHref(icon, pageUrl) !== '#' ? '_blank' : undefined}
            rel={getShareHref(icon, pageUrl) !== '#' ? 'noopener noreferrer' : undefined}
            class={`more-item shrink-0 ${LINK} opacity-0 pointer-events-none transition-[opacity,transform] duration-300 ease-out`}
            data-share-btn={icon}
            aria-label={getShareLabel(icon, locale)}
            aria-hidden="true"
            tabindex="-1"
          >
            <Icon name={`tabler:${icon}`} class={ICON} />
          </LinkButton>
        </Tooltip>
      ))}
    </span>

    <!-- toggle button -->
    <button
      data-share-toggle
      data-tip-collapsed={t(UI.share.more, locale)}
      data-tip-expanded={t(UI.share.less, locale)}
      aria-label={t(UI.share.more, locale)}
      aria-expanded="false"
      class="focus-ring hover-quiet group inline-flex items-center gap-1 scale-90 border-0 bg-transparent p-2 text-text-secondary sm:p-1 cursor-pointer max-md:order-1"
    >
      <span class="share-toggle-collapsed"><Icon name="tabler:plus" class={ICON} /></span>
      <span class="share-toggle-expanded hidden"><Icon name="tabler:minus" class={ICON} /></span>
    </button>
  </div>
</div>
